@import url("../Tokens/ss3d-tokens.uss");
@import url("../Tokens/ss3d-typography.uss");
@import url("CharacterCreator.uss");

/* Lobby shell — Phase A visual. Flat charcoal chrome; functional buttons are borderless fills. */

.lobby-shell {
    --ss3d-text-primary: #ffffff;
    --ss3d-text-secondary: #aaaaaa;
    --ss3d-text-tertiary: #717c7f;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(22, 22, 22, 0.86);
}

/* Both surfaces are siblings on Modal, so each must own these variables. */
.lobby-shell, .char-creator {
    --lobby-btn-green: #6fa055;
    --lobby-btn-green-hover: #88b36a;
    --lobby-btn-blue: #3d6089;
    --lobby-btn-blue-hover: #5f86b3;
    --lobby-btn-amber: #c98f38;
    --lobby-btn-amber-hover: #e6ad53;
    --lobby-surface-panel: #353538;
    --lobby-surface-raised: #161616;
    --lobby-surface-inset: #2a2a2e;
    --lobby-border-subtle: rgba(216, 216, 216, 0.1);
    --lobby-priority-never: #717c7f;
    --lobby-priority-low: #3d6089;
    --lobby-priority-medium: #c98f38;
    --lobby-priority-high: #b13d3d;
}

/* Player View width; owner-requested taller shell fits Server Info without scrolling. */
.lobby-shell__window {
    width: 70%;
    min-width: 900px;
    max-width: 1180px;
    height: 840px;
    max-height: 92%;
    flex-direction: column;
    background-color: var(--ss3d-surface-void);
    border-width: 1px;
    border-color: var(--lobby-border-subtle);
    border-style: solid;
    overflow: hidden;
}

.lobby-shell__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px 20px;
    min-height: 0;
    background-color: var(--lobby-surface-raised);
    border-bottom-width: 1px;
    border-bottom-color: var(--lobby-border-subtle);
    border-bottom-style: solid;
    flex-shrink: 0;
}

.lobby-shell__header-left,
.lobby-shell__header-right {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.lobby-shell__header-left {
    flex-grow: 1;
    overflow: hidden;
}

.lobby-shell__header-sep {
    color: var(--ss3d-text-tertiary);
    margin-left: 8px;
    margin-right: 8px;
    font-size: 11px;
}

.lobby-shell__header-meta {
    font-size: 11px;
    color: var(--ss3d-text-secondary);
    margin-left: 0;
}

.lobby-shell__header .font-body {
    font-size: 13px;
}

.lobby-shell__body {
    position: relative;
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    padding: 0;
}

.lobby-shell__main {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 280px;
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    margin-right: 0;
}

.lobby-shell__tabs {
    flex-direction: row;
    flex-shrink: 0;
    background-color: var(--lobby-surface-raised);
    padding: 0;
}

.lobby-shell__tab {
    flex-grow: 1;
    flex-basis: 0;
    height: 48px;
    padding: 0 20px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-style: solid;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    color: var(--ss3d-text-secondary);
    font-size: 20px;
    letter-spacing: 1px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    margin: 0;
}

.lobby-shell__tab:hover {
    color: var(--ss3d-text-primary);
    background-color: var(--lobby-surface-inset);
}

.lobby-shell__tab--active {
    color: var(--ss3d-text-primary);
    background-color: var(--lobby-surface-panel);
    border-bottom-color: var(--ss3d-accent-rust);
}

.lobby-shell__tab--admin.lobby-shell__tab--active {
    border-bottom-color: var(--lobby-btn-amber);
}

.lobby-shell__tab-content {
    flex-grow: 1;
    min-height: 0;
    background-color: var(--lobby-surface-panel);
    padding: 24px;
}

.lobby-shell__tab-content--panel {
    background-color: #353538;
}

.lobby-shell__sidebar {
    margin-left: auto;
    width: 280px;
    flex-shrink: 0;
    flex-direction: column;
    min-height: 0;
    padding: 16px;
    background-color: var(--lobby-surface-panel);
    border-left-width: 1px;
    border-left-color: var(--lobby-border-subtle);
    border-left-style: solid;
}

.lobby-shell__panel {
    background-color: var(--lobby-surface-panel);
    margin-bottom: 16px;
    flex-shrink: 0;
}

.lobby-shell__panel-header {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    background-color: var(--lobby-surface-raised);
}

.lobby-shell__panel-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: #45454a;
    margin-right: 8px;
    flex-shrink: 0;
}

.lobby-shell__panel-dot--live {
    background-color: var(--ss3d-feedback-success);
}

.lobby-shell__panel-title {
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--ss3d-text-primary);
    text-transform: uppercase;
}

.lobby-shell__panel-accent {
    height: 2px;
    background-color: var(--ss3d-feedback-danger);
    flex-shrink: 0;
}

.lobby-shell__panel-body {
    padding: 16px 14px;
    background-color: var(--lobby-surface-inset);
    align-items: center;
}

.lobby-shell__countdown {
    font-size: 32px;
    color: #88b36a;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.lobby-shell__countdown-sub {
    font-size: 11px;
    color: var(--ss3d-text-tertiary);
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.lobby-shell__preview {
    flex-grow: 0;
    flex-shrink: 0;
    height: 340px;
    min-height: 340px;
    background-color: var(--lobby-surface-inset);
    margin-bottom: 16px;
    align-items: stretch;
    justify-content: flex-start;
}

.lobby-shell__character-name {
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--ss3d-text-secondary);
    text-transform: uppercase;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.lobby-shell__preview-image {
    flex-grow: 1;
    min-height: 160px;
    -unity-background-scale-mode: scale-and-crop;
}

.lobby-shell__preview-hint {
    display: none;
    padding: 6px 10px;
    font-size: 10px;
    color: var(--ss3d-text-tertiary);
    letter-spacing: 1px;
    text-transform: uppercase;
    -unity-text-align: middle-center;
    background-color: var(--lobby-surface-raised);
    flex-shrink: 0;
}

.lobby-shell__actions {
    flex-direction: column;
    flex-shrink: 0;
    margin-top: auto;
}

.lobby-shell__btn {
    border-width: 0;
    border-radius: 0;
    margin: 0;
    padding: 0;
    color: #ffffff;
    letter-spacing: 1px;
    font-size: 14px;
    -unity-text-align: middle-center;
}

.lobby-shell__btn--ready {
    height: 48px;
    width: 100%;
    background-color: #45454a;
    margin-bottom: 8px;
}

.lobby-shell__btn--ready:hover {
    background-color: #2a2a2e;
}

.lobby-shell__btn--ready-on {
    background-color: var(--lobby-btn-green);
}

.lobby-shell__btn--ready-on:hover {
    background-color: var(--lobby-btn-green-hover);
}

.lobby-shell__actions-row {
    flex-direction: row;
}

.lobby-shell__btn--observe {
    flex-grow: 1;
    height: 40px;
    background-color: var(--lobby-btn-blue);
    margin-right: 8px;
}

.lobby-shell__btn--observe:hover {
    background-color: var(--lobby-btn-blue-hover);
}

.lobby-shell__btn--observe-on {
    background-color: var(--lobby-btn-green);
}

.lobby-shell__btn--observe-on:hover {
    background-color: var(--lobby-btn-green-hover);
}

.lobby-shell__display-prompt {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
}

.lobby-shell__display-prompt-card {
    width: 420px;
    padding: 24px;
    background-color: #1e1e22;
    border-width: 1px;
    border-color: #45454a;
}

.lobby-shell__display-prompt-text {
    color: #ffffff;
    font-size: 15px;
    white-space: normal;
    margin-bottom: 18px;
}

.lobby-shell__btn--prompt-keep {
    flex-grow: 1;
    height: 40px;
    margin-right: 8px;
    background-color: var(--lobby-btn-green);
}

.lobby-shell__btn--prompt-keep:hover {
    background-color: var(--lobby-btn-green-hover);
}

.lobby-shell__btn--settings-reset {
    align-self: flex-start;
    height: 40px;
    padding: 0 24px;
    margin-top: 8px;
    background-color: var(--lobby-btn-blue);
}

.lobby-shell__btn--settings-reset:hover {
    background-color: var(--lobby-btn-blue-hover);
}

.lobby-shell__btn--admin {
    flex-grow: 1;
    height: 40px;
    background-color: var(--lobby-btn-amber);
}

.lobby-shell__btn--admin:hover {
    background-color: var(--lobby-btn-amber-hover);
}

.lobby-shell__btn--admin-on {
    background-color: var(--lobby-btn-amber-hover);
}

.lobby-shell__btn--report {
    height: 34px;
    margin-top: 8px;
    background-color: #3a3a40;
    color: #c8c8cc;
}

.lobby-shell__btn--report:hover {
    background-color: #55555c;
    color: #ffffff;
}

.lobby-shell__btn--quit {
    height: 34px;
    margin-top: 8px;
    background-color: #3a3a40;
    color: #c8c8cc;
}

.lobby-shell__btn--quit:hover {
    background-color: #55555c;
}

.lobby-shell__btn--quit-armed,
.lobby-shell__btn--quit-armed:hover {
    background-color: #a8443a;
    color: #ffffff;
}

/* Non-admin Admin, unwired Observe, Ready while Ending: the fill colours otherwise look clickable. */
.lobby-shell__btn:disabled {
    opacity: 0.35;
}

.lobby-shell__section-title {
    font-size: 16px;
    letter-spacing: 1px;
    color: var(--ss3d-text-primary);
    text-transform: uppercase;
    margin-bottom: 8px;
}

.lobby-shell__inset {
    background-color: var(--lobby-surface-inset);
    padding: 12px 14px;
    color: var(--ss3d-text-secondary);
    font-size: 13px;
    white-space: normal;
}

.lobby-shell__info-grid {
    flex-direction: row;
    margin-bottom: 16px;
}

.lobby-shell__info-col {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 12px;
}

.lobby-shell__info-col:last-child {
    margin-right: 0;
}

.lobby-shell__motd {
    margin-bottom: 14px;
    flex-shrink: 0;
}

.lobby-shell__motd .lobby-shell__inset {
    max-height: 110px;
    background-color: #353538;
    color: var(--ss3d-text-secondary);
}

.lobby-shell__server-body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    align-items: stretch;
}

.lobby-shell__server-left {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    flex-direction: column;
    margin-right: 16px;
}

.lobby-shell__bottom-row {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    align-items: stretch;
}

.lobby-shell__map-mode-block {
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: column;
    margin-right: 0;
}

.lobby-shell__map-mode-row {
    flex-direction: row;
}

.lobby-shell__select-card {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    background-color: var(--lobby-surface-panel);
    padding: 8px 10px;
    margin-right: 12px;
    min-width: 0;
    min-height: 0;
    height: 52px;
}

.lobby-shell__select-card:last-child {
    margin-right: 0;
}

.lobby-shell__select-swatch {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    margin-right: 10px;
    align-items: center;
    justify-content: center;
    background-color: #45454a;
}

.lobby-shell__select-swatch-label {
    font-size: 15px;
    color: var(--ss3d-text-primary);
    -unity-text-align: middle-center;
}

.lobby-shell__select-swatch--map {
    background-color: #717c7f;
}

.lobby-shell__select-text {
    flex-grow: 1;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
}

.lobby-shell__select-name {
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--ss3d-text-primary);
    text-transform: uppercase;
    margin-bottom: 0;
    padding-bottom: 0;
}

.lobby-shell__select-kind {
    font-size: 11px;
    color: var(--ss3d-text-tertiary);
    margin-top: 0;
    padding-top: 0;
}

.lobby-shell__changelog-col {
    flex-grow: 1.4;
    flex-basis: 0;
    flex-shrink: 1;
    flex-direction: column;
    min-height: 0;
    align-self: stretch;
    min-width: 0;
}

.lobby-shell__changelog-col .lobby-shell__inset {
    flex-grow: 1;
    min-height: 0;
    max-height: 260px;
    min-width: 0;
    background-color: #353538;
    overflow: hidden;
}

.lobby-shell__changelog-header {
    flex-direction: row;
    align-items: baseline;
    justify-content: space-between;
}

.lobby-shell__link {
    font-size: 13px;
    color: var(--lobby-btn-blue-hover);
}

.lobby-shell__link:hover {
    color: #ffffff;
}

.lobby-shell__changelog-group {
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--lobby-btn-amber);
    margin-top: 4px;
    margin-bottom: 4px;
}

.lobby-shell__changelog-row {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 4px;
    padding: 2px 4px;
    min-width: 0;
    flex-shrink: 0;
    border-radius: 2px;
}

.lobby-shell__changelog-row--link:hover {
    background-color: #45454a;
}

.lobby-shell__changelog-ver {
    color: var(--ss3d-text-primary);
    font-size: 13px;
    margin-right: 10px;
    min-width: 34px;
    flex-shrink: 0;
}

.lobby-shell__changelog-text {
    color: var(--ss3d-text-secondary);
    font-size: 14px;
    white-space: normal;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    overflow: hidden;
}

.lobby-shell__changelog-empty {
    color: var(--ss3d-text-secondary);
    font-size: 14px;
    white-space: normal;
    flex-shrink: 0;
}

.lobby-shell__server-title-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    min-height: 32px;
}

.lobby-shell__server-title {
    font-size: 28px;
    color: var(--ss3d-text-primary);
    letter-spacing: 1px;
    text-transform: uppercase;
    flex-grow: 1;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    -unity-text-align: middle-left;
}

.lobby-shell__server-meta {
    font-size: 13px;
    color: var(--ss3d-text-tertiary);
    margin-bottom: 0;
    margin-left: 12px;
    flex-shrink: 0;
    letter-spacing: 0;
    text-transform: none;
    padding-top: 0;
    padding-bottom: 0;
    -unity-text-align: middle-right;
}

/* Derive height from the banner aspect; allow shrinking to keep information visible. */
.lobby-shell__hero {
    width: 100%;
    height: 275px;
    flex-shrink: 0;
    background-color: var(--lobby-surface-raised);
    margin-bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.lobby-shell__hero-mark {
    font-size: 28px;
    color: var(--ss3d-text-primary);
    letter-spacing: 2px;
}

.lobby-shell__hero-mark-accent {
    color: var(--ss3d-accent-rust);
}

.lobby-shell__jobs {
    flex-grow: 1;
    min-height: 0;
}

.lobby-shell__jobs-split {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.lobby-shell__jobs-list {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
    margin-right: 24px;
    background-color: var(--lobby-surface-inset);
    padding: 0;
}

.lobby-shell__antag {
    width: 240px;
    flex-shrink: 0;
    background-color: var(--lobby-surface-inset);
    padding: 14px;
}

.lobby-shell__dept-header {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    background-color: var(--lobby-surface-raised);
    margin-bottom: 2px;
}

.lobby-shell__dept-icon {
    width: 16px;
    height: 16px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--ss3d-text-secondary);
}

.lobby-shell__dept-name {
    flex-grow: 1;
    font-size: 15px;
    letter-spacing: 1px;
    color: var(--ss3d-text-primary);
    text-transform: uppercase;
    -unity-font-style: normal;
}

.lobby-shell__dept-slots {
    font-size: 12px;
    color: var(--ss3d-text-secondary);
    margin-right: 8px;
}

.lobby-shell__dept-chevron {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--ss3d-text-tertiary);
    rotate: 0deg;
}

.lobby-shell__dept-chevron--collapsed {
    rotate: 270deg;
}

.lobby-shell__job-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    border-bottom-width: 1px;
    border-bottom-color: var(--lobby-border-subtle);
    border-bottom-style: solid;
    background-color: var(--lobby-surface-inset);
}

.lobby-shell__job-row--locked {
    opacity: 0.55;
}

.lobby-shell__job-icon-well {
    width: 30px;
    height: 30px;
    margin-right: 8px;
    background-color: #161616;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.lobby-shell__job-icon {
    width: 20px;
    height: 20px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--ss3d-text-secondary);
}

.lobby-shell__job-info {
    flex-grow: 1;
    min-width: 0;
    flex-direction: column;
}

.lobby-shell__job-name {
    font-size: 13px;
    color: var(--ss3d-text-primary);
}

.lobby-shell__job-meta {
    font-size: 12px;
    letter-spacing: 0.2px;
    color: var(--ss3d-text-secondary);
    margin-top: 2px;
    opacity: 0.95;
}

.lobby-shell__priority {
    flex-direction: row;
    flex-shrink: 0;
    margin-left: 8px;
}

.lobby-shell__priority-chip {
    width: 20px;
    height: 24px;
    margin-left: 0;
    border-width: 0;
    border-radius: 0;
    padding: 0;
    font-size: 11px;
    color: #ffffff;
    background-color: #45454a;
    -unity-text-align: middle-center;
}

.lobby-shell__priority-chip--never {
    background-color: var(--lobby-priority-never);
}

.lobby-shell__priority-chip--low {
    background-color: var(--lobby-priority-low);
}

.lobby-shell__priority-chip--medium {
    background-color: var(--lobby-priority-medium);
}

.lobby-shell__priority-chip--high {
    background-color: var(--lobby-priority-high);
}

.lobby-shell__priority-chip--idle {
    background-color: #45454a;
    color: var(--ss3d-text-tertiary);
}

.lobby-shell__antag-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 4px;
}

.lobby-shell__check {
    width: 16px;
    height: 16px;
    margin-right: 10px;
    background-color: var(--lobby-surface-raised);
    border-width: 1px;
    border-color: var(--ss3d-border-strong);
    border-style: solid;
    border-radius: 2px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.lobby-shell__check--on {
    background-color: var(--ss3d-accent-rust);
    border-color: var(--ss3d-accent-rust);
}

.lobby-shell__check-mark {
    font-size: 11px;
    color: #fff8ef;
    -unity-text-align: middle-center;
}

.lobby-shell__antag-name {
    font-size: 13px;
    color: var(--ss3d-text-primary);
}

.lobby-shell__antag-divider {
    height: 1px;
    margin-top: 10px;
    margin-bottom: 10px;
    background-color: var(--lobby-border-subtle);
    flex-shrink: 0;
}

.lobby-shell__antag-hint {
    font-size: 11px;
    color: var(--ss3d-text-tertiary);
    white-space: normal;
    margin-top: 0;
    margin-bottom: 0;
}

.lobby-shell__link {
    font-size: 11px;
    color: #5f86b3;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.lobby-shell__players-toolbar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.lobby-shell__players-count {
    font-size: 14px;
    letter-spacing: 1px;
    color: var(--ss3d-text-tertiary);
    margin-left: 10px;
    flex-shrink: 0;
}

.lobby-shell__players-list {
    flex-grow: 1;
    min-height: 0;
}

.lobby-shell__player-card {
    background-color: #2a2a2e;
    margin-bottom: 6px;
    flex-shrink: 0;
}

.lobby-shell__player-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
}

.lobby-shell__player-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 10px;
    flex-shrink: 0;
    background-color: #45454a;
}

.lobby-shell__player-dot--ready {
    background-color: var(--ss3d-feedback-success);
}

.lobby-shell__player-name {
    flex-shrink: 0;
    font-size: 16px;
    letter-spacing: 1px;
    color: var(--ss3d-text-primary);
    margin-right: 10px;
}

.lobby-shell__player-badge {
    flex-shrink: 0;
    font-size: 10px;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 2px 7px;
    margin-right: 10px;
    color: var(--ss3d-text-on-accent);
    background-color: #717c7f;
    -unity-text-align: middle-center;
}

.lobby-shell__player-badge--admin {
    background-color: #e6ad53;
}

.lobby-shell__player-badge--mentor {
    background-color: #5f86b3;
}

.lobby-shell__player-status {
    flex-grow: 1;
    font-size: 12px;
    color: var(--ss3d-text-tertiary);
}

.lobby-shell__player-chevron {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--ss3d-text-tertiary);
    rotate: 0deg;
}

.lobby-shell__player-chevron--collapsed {
    rotate: 270deg;
}

.lobby-shell__player-detail {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px 12px 14px;
    margin: 0 14px 10px 14px;
    border-top-width: 1px;
    border-top-color: var(--lobby-border-subtle);
    border-top-style: solid;
}

.lobby-shell__player-meta {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.lobby-shell__player-meta-item {
    font-size: 12px;
    color: var(--ss3d-text-secondary);
    margin-right: 20px;
    flex-shrink: 0;
}

.lobby-shell__player-actions {
    flex-direction: row;
    flex-shrink: 0;
}

.lobby-shell__player-action {
    height: 28px;
    padding: 0 10px;
    margin-left: 6px;
    border-width: 0;
    border-radius: 0;
    background-color: var(--lobby-surface-raised);
    color: var(--ss3d-feedback-danger);
    font-size: 11px;
    letter-spacing: 1px;
}

.lobby-shell__player-action:hover {
    background-color: var(--ss3d-feedback-danger-bg);
}

.lobby-shell__chat {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
}

.lobby-shell__chat-log {
    flex-grow: 1;
    min-height: 120px;
    background-color: #2a2a2e;
    padding: 10px 4px;
    margin-bottom: 10px;
}

.lobby-shell__chat-line {
    flex-direction: row;
    align-items: flex-start;
    padding: 3px 12px;
    margin-bottom: 0;
}

.lobby-shell__chat-time {
    flex-shrink: 0;
    font-size: 11px;
    color: var(--ss3d-text-tertiary);
    margin-right: 8px;
    padding-top: 1px;
}

.lobby-shell__chat-name {
    flex-shrink: 0;
    font-size: 12px;
    color: var(--ss3d-text-primary);
    margin-right: 8px;
    -unity-font-style: bold;
}

.lobby-shell__chat-name--admin {
    color: #e6ad53;
}

.lobby-shell__chat-name--mentor {
    color: #5f86b3;
}

.lobby-shell__chat-text {
    flex-grow: 1;
    flex-shrink: 1;
    /* The 12px terminal font sits low next to the 11px time / bold name; lift it onto their baseline. */
    margin-top: -1px;
    font-size: 12px;
    color: var(--ss3d-text-secondary);
    white-space: normal;
}

.lobby-shell__chat-announcement {
    align-items: center;
    padding: 8px 16px;
    margin: 4px 0;
}

.lobby-shell__chat-announcement-text {
    font-size: 12px;
    color: #e6ad53;
    letter-spacing: 0.5px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.lobby-shell__chat-empty {
    font-size: 12px;
    color: var(--ss3d-text-tertiary);
    padding: 3px 12px;
}

.lobby-shell__chat-composer {
    flex-direction: row;
    flex-shrink: 0;
}

.lobby-shell__chat-input {
    flex-grow: 1;
    height: 40px;
    margin: 0;
    padding: 0;
    background-color: #2a2a2e;
    border-width: 1px;
    border-color: #5c5955;
    border-style: solid;
    border-radius: 0;
    color: var(--ss3d-text-primary);
}

.lobby-shell__chat-input > .unity-base-field__label {
    display: none;
    width: 0;
    min-width: 0;
    margin: 0;
    padding: 0;
}

.lobby-shell__chat-input > .unity-base-field__input,
.lobby-shell__chat-input > .unity-text-field__input,
.lobby-shell__chat-input > .unity-base-text-field__input {
    flex-grow: 1;
    height: 100%;
    margin: 0;
    padding: 10px 12px;
    background-color: #2a2a2e;
    border-width: 0;
    border-radius: 0;
    color: var(--ss3d-text-primary);
}

.lobby-shell__chat-input:focus,
.lobby-shell__chat-input > .unity-base-field__input:focus,
.lobby-shell__chat-input > .unity-text-field__input:focus,
.lobby-shell__chat-input > .unity-base-text-field__input:focus {
    border-color: #5c5955;
    background-color: #2a2a2e;
}

.lobby-shell__chat-input .unity-base-text-field__input--placeholder {
    color: var(--ss3d-text-tertiary);
}

.lobby-shell__channel-row {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: var(--lobby-border-subtle);
    border-bottom-style: solid;
}

.lobby-shell__channel {
    padding: 0 0 8px 0;
    margin-right: 18px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-style: solid;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    color: var(--ss3d-text-tertiary);
    font-size: 12px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.lobby-shell__channel:hover {
    color: var(--ss3d-text-secondary);
    background-color: rgba(0, 0, 0, 0);
}

.lobby-shell__channel--active {
    background-color: rgba(0, 0, 0, 0);
    color: var(--ss3d-text-primary);
    border-bottom-color: var(--ss3d-accent-rust);
}

.lobby-shell__settings-tabs {
    flex-direction: row;
    margin-bottom: 12px;
}

.lobby-shell__setting-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--lobby-border-subtle);
    border-bottom-style: solid;
}

.lobby-shell__setting-label {
    font-size: 13px;
    color: var(--ss3d-text-primary);
}

.lobby-shell__setting-value {
    font-size: 12px;
    color: var(--ss3d-text-secondary);
}

.lobby-shell__admin-controls {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 16px;
}

.lobby-shell__admin-btn {
    height: 36px;
    padding: 0 14px;
    margin-right: 8px;
    margin-bottom: 8px;
    border-width: 0;
    border-radius: 0;
    background-color: var(--lobby-btn-blue);
    color: #ffffff;
    font-size: 12px;
    letter-spacing: 1px;
}

.lobby-shell__admin-btn--danger {
    background-color: #b13d3d;
}

.lobby-shell__admin-btn--amber {
    background-color: var(--lobby-btn-amber);
}

.lobby-shell__placeholder {
    color: var(--ss3d-text-tertiary);
    font-size: 13px;
    white-space: normal;
    padding: 24px;
    -unity-text-align: middle-center;
}

.lobby-shell__search {
    flex-grow: 1;
    max-width: 280px;
    height: 32px;
    margin: 0;
    padding: 0;
    background-color: #2a2a2e;
    border-width: 1px;
    border-color: #5c5955;
    border-style: solid;
    border-radius: 0;
    color: var(--ss3d-text-primary);
}

.lobby-shell__search > .unity-base-field__label {
    display: none;
    width: 0;
    min-width: 0;
    margin: 0;
    padding: 0;
}

.lobby-shell__search > .unity-base-field__input,
.lobby-shell__search > .unity-text-field__input,
.lobby-shell__search > .unity-base-text-field__input,
.lobby-shell__search .unity-base-text-field__input {
    flex-grow: 1;
    height: 100%;
    margin: 0;
    padding: 4px 10px;
    background-color: #2a2a2e;
    border-width: 0;
    border-radius: 0;
    color: var(--ss3d-text-primary);
}

.lobby-shell__search:focus,
.lobby-shell__search > .unity-base-field__input:focus,
.lobby-shell__search > .unity-text-field__input:focus,
.lobby-shell__search > .unity-base-text-field__input:focus,
.lobby-shell__search .unity-base-text-field__input:focus {
    background-color: #2a2a2e;
    border-color: #5c5955;
}

.lobby-shell__search .unity-base-text-field__input--placeholder {
    color: var(--ss3d-text-tertiary);
}

/* Settings uses underlined secondary tabs, not another row of filled primary tabs. */
.lobby-shell__settings-tabs {
    border-bottom-width: 1px;
    border-bottom-color: var(--lobby-border-subtle);
    margin-bottom: 16px;
    flex-shrink: 0;
}
.lobby-shell__settings-tab {
    margin: 0 20px 0 0;
    padding: 0 0 10px 0;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0,0,0,0);
    border-radius: 0;
    background-color: rgba(0,0,0,0);
    color: var(--ss3d-text-secondary);
    font-size: 15px;
    letter-spacing: 1px;
}
.lobby-shell__settings-tab--active {
    border-bottom-color: var(--ss3d-accent-rust);
    color: var(--ss3d-text-primary);
}
.lobby-shell__settings-scroll, .lobby-shell__server-scroll {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}
.lobby-shell__settings-form { max-width: 420px; }
.lobby-shell__settings-label {
    font-size: 12px;
    color: var(--ss3d-text-tertiary);
    letter-spacing: 1px;
    margin-bottom: 6px;
}
.lobby-shell__settings-dropdown {
    height: 38px;
    margin: 0 0 18px 0;
    font-size: 15px;
    color: var(--ss3d-text-primary);
}
.lobby-shell__settings-dropdown > .unity-base-field__input {
    background-color: var(--lobby-surface-inset);
    border-width: 1px;
    border-color: #45454a;
    border-radius: 0;
    padding: 8px 10px;
}
.lobby-shell__settings-dropdown .unity-base-popup-field__text { color: var(--ss3d-text-primary); }
.lobby-shell__settings-toggle {
    margin: 0 0 18px 0;
    padding: 0;
    color: var(--ss3d-text-secondary);
    font-size: 13px;
}
.lobby-shell__settings-toggle .unity-base-field__input { background-color: rgba(0,0,0,0); }
.lobby-shell__settings-toggle .unity-toggle__checkmark {
    width: 16px;
    height: 16px;
    margin-right: 10px;
    border-width: 1px;
    border-color: #45454a;
    border-radius: 2px;
    background-color: var(--lobby-surface-inset);
}
.lobby-shell__settings-toggle:checked .unity-toggle__checkmark {
    background-color: var(--lobby-btn-blue);
    border-color: var(--lobby-btn-blue);
}
.lobby-shell__settings-toggle .unity-toggle__text { color: var(--ss3d-text-secondary); }
.lobby-shell__settings-slider-field { margin-bottom: 18px; }
.lobby-shell__settings-slider-row { flex-direction: row; align-items: center; }
.lobby-shell__settings-slider { flex-grow: 1; height: 18px; margin: 0; }
.lobby-shell__settings-slider .unity-base-slider__tracker {
    height: 14px;
    background-color: var(--lobby-surface-inset);
    border-width: 0;
    border-radius: 3px;
}
.lobby-shell__settings-slider .unity-base-slider__dragger {
    width: 5px;
    height: 18px;
    margin-top: -2px;
    background-color: var(--ss3d-text-primary);
    border-width: 0;
    border-radius: 2px;
}
.lobby-shell__settings-slider:disabled { opacity: 0.4; }
.lobby-shell__settings-slider-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: var(--lobby-btn-blue);
    border-radius: 3px;
}
.lobby-shell__settings-number {
    width: 40px;
    margin-left: 6px;
    font-size: 11px;
    color: var(--ss3d-text-primary);
    -unity-text-align: middle-right;
}
.lobby-shell__binding-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 9px 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--lobby-border-subtle);
}
.lobby-shell__binding-label { color: var(--ss3d-text-secondary); font-size: 13px; }
.lobby-shell__binding-button {
    min-width: 76px;
    padding: 5px 10px;
    margin: 0;
    background-color: var(--lobby-surface-raised);
    color: var(--ss3d-text-primary);
    border-width: 0;
    border-radius: 3px;
    font-size: 11px;
}
.lobby-shell__binding-button--listening { background-color: var(--lobby-btn-blue); }
.lobby-shell__binding-button:disabled { opacity: 0.45; }
.lobby-shell__toast {
    position: absolute;
    bottom: 48px;
    left: 50%;
    translate: -50% 0;
    padding: 12px 20px;
    background-color: #1e1e22;
    border-width: 1px;
    border-color: var(--lobby-btn-amber);
    color: #ffffff;
    font-size: 15px;
}
.lobby-shell__server-card { background-color: var(--lobby-surface-inset); flex-shrink: 0; }
.lobby-shell__server-information { padding: 18px 20px 20px 20px; }
.lobby-shell__server-title { font-size: 26px; }
.lobby-shell__server-body { flex-shrink: 0; }
.lobby-shell__server-left { margin-right: 20px; }
.lobby-shell__server-title-row { flex-wrap: wrap; }
.lobby-shell__server-meta { font-size: 13px; }
.lobby-shell__countdown--waiting { font-size: 13px; color: var(--ss3d-text-tertiary); }
.lobby-shell__job-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.lobby-shell__job-slots {
    min-width: 26px;
    margin-left: 8px;
    font-size: 13px;
    -unity-text-align: middle-right;
    color: var(--ss3d-text-secondary);
}
.lobby-shell__check--on { background-color: var(--lobby-btn-blue); border-color: var(--lobby-btn-blue); }

.lobby-shell__settings-toggle .unity-base-field__input { flex-grow: 1; flex-basis: auto; justify-content: flex-start; }
.lobby-shell__settings-toggle .unity-toggle__text { margin-left: 0; }
.lobby-shell__countdown-sub { font-size: 17px; }
.lobby-shell .unity-scroller--vertical { width: 8px; min-width: 8px; max-width: 8px; }
.lobby-shell .unity-scroller__low-button, .lobby-shell .unity-scroller__high-button { display: none; }
.lobby-shell .unity-scroller__slider { margin: 0; }
.lobby-shell .unity-scroller__slider .unity-base-slider__tracker {
    background-color: var(--lobby-surface-panel);
    border-width: 0;
    border-radius: 3px;
}
.lobby-shell .unity-scroller__slider .unity-base-slider__dragger {
    background-color: #45454a;
    border-width: 0;
    border-radius: 3px;
}

.lobby-shell {
    --lobby-btn-green: #88b36a;
    --lobby-btn-green-hover: #a8cf8c;
    --lobby-btn-amber: #e6ad53;
    --lobby-btn-amber-hover: #f0c47d;
}
.lobby-shell__btn { font-size: 20px; -unity-font-style: bold; border-radius: 3px; }
.lobby-shell__preview { border-width: 1px; border-color: #45454a; border-radius: 0; overflow: hidden; }

/* Server Info fits its pane; prioritize text/cards over banner height on short views. */
.lobby-shell__server-card { flex-shrink: 1; min-height: 0; }
.lobby-shell__hero { flex-shrink: 1; min-height: 100px; }
.lobby-shell__server-information { flex-shrink: 0; }
.lobby-shell__actions { margin-top: auto; padding-top: 16px; flex-shrink: 0; }
/* On short windows the preview gives up height instead of overlapping the Ready/Join button. */
.lobby-shell__preview { flex-shrink: 1; min-height: 160px; }

/* Admin Server Settings, matching the attached pre-round reference. */
.lobby-shell__server-settings-scroll { flex-grow: 1; flex-basis: 0; min-height: 0; }
.lobby-shell__server-settings { max-width: 640px; flex-shrink: 0; padding-right: 4px; }
.lobby-shell__round-card { background-color: var(--lobby-surface-inset); margin-bottom: 22px; flex-shrink: 0; }
.lobby-shell__round-card-heading {
    height: 42px; margin: 0; padding: 0 14px; -unity-text-align: middle-left;
    background-color: var(--lobby-surface-raised);
    border-bottom-width: 2px; border-bottom-color: #b13d3d;
    font-size: 24px; letter-spacing: 1px; color: var(--ss3d-text-primary);
}
.lobby-shell__round-card-body { height: 86px; flex-direction: row; justify-content: space-between; align-items: center; padding: 10px 14px; }
.lobby-shell__round-card-body Label { color: var(--ss3d-text-tertiary); margin: 0; padding: 0; }
.lobby-shell__round-card-body .lobby-shell__round-state { height: 32px; font-size: 26px; color: var(--ss3d-text-secondary); letter-spacing: 1px; }
.lobby-shell__round-card-body .lobby-shell__round-detail { height: 24px; font-size: 15px; color: var(--ss3d-text-secondary); }
.lobby-shell__round-card-body .lobby-shell__ready-ratio { height: 34px; font-size: 24px; color: var(--ss3d-text-primary); }
.lobby-shell__server-settings .lobby-shell__section-title { height: 28px; margin: 0 0 8px; padding: 0; font-size: 22px; color: var(--ss3d-text-tertiary); }
.lobby-shell__server-settings .lobby-shell__admin-controls { margin-bottom: 22px; }
.lobby-shell__server-settings .lobby-shell__admin-btn { height: 40px; margin: 0 10px 0 0; padding: 0 16px; font-size: 20px; -unity-font-style: bold; border-radius: 3px; }
.lobby-shell__admin-btn--start { background-color: var(--lobby-btn-green); }
.lobby-shell__admin-btn--outline {
    background-color: rgba(0,0,0,0); border-width: 1px;
    border-color: var(--lobby-btn-amber); color: var(--lobby-btn-amber);
}
.lobby-shell__admin-btn:disabled { opacity: 0.35; }
.lobby-shell__server-select { height: 64px; flex-shrink: 0; flex-direction: column; align-items: stretch; background-color: var(--lobby-surface-inset); padding: 8px 14px; margin: 0 0 10px; }
.lobby-shell__server-select > .unity-base-field__label { height: 16px; min-height: 16px; color: var(--ss3d-text-tertiary); font-size: 12px; min-width: 0; margin: 0 0 4px; padding: 0; }
.lobby-shell__server-select > .unity-base-field__input { height: 26px; min-height: 26px; padding: 0; background-color: rgba(0,0,0,0); border-width: 0; color: var(--ss3d-text-primary); font-size: 16px; border-radius: 0; }
.lobby-shell__server-map { padding-left: 60px; }
.lobby-shell__server-text { flex-shrink: 0; flex-direction: column; align-items: stretch; margin: 0 0 10px; }
.lobby-shell__server-text > .unity-base-field__label { height: 18px; min-height: 18px; min-width: 0; margin: 0 0 6px; padding: 0; color: var(--ss3d-text-tertiary); font-size: 12px; }
.lobby-shell__server-text > .unity-base-field__input {
    min-height: 36px; padding: 8px 10px; border-width: 1px; border-color: var(--lobby-border-subtle);
    border-radius: 0; color: var(--ss3d-text-primary); font-size: 14px;
}
.lobby-shell__server-text--multiline > .unity-base-field__input { min-height: 96px; white-space: normal; -unity-text-align: upper-left; }
.lobby-shell__server-map-swatch { position: absolute; left: 14px; top: 15px; width: 34px; height: 34px; background-color: #5e7a8a; color: #ffffff; font-size: 16px; -unity-text-align: middle-center; }
.lobby-shell__server-numbers { flex-direction: row; margin-top: 12px; margin-bottom: 22px; flex-shrink: 0; }
.lobby-shell__server-number { flex-grow: 1; flex-basis: 0; margin-right: 16px; }
.lobby-shell__server-number > Label { height: 18px; margin: 0 0 6px; color: var(--ss3d-text-tertiary); font-size: 12px; padding: 0; }
.lobby-shell__server-number .unity-base-field { margin: 0; height: 38px; }
.lobby-shell__server-number .unity-base-field__input {
    background-color: var(--lobby-surface-inset); border-width: 1px;
    border-color: var(--lobby-border-subtle); border-radius: 0;
    color: var(--ss3d-text-primary); padding: 8px 10px; min-height: 36px; font-size: 16px;
}
.lobby-shell__server-settings .lobby-shell__settings-toggle { min-height: 34px; flex-shrink: 0; margin: 0; }
.lobby-shell__server-status { color: var(--ss3d-text-tertiary); white-space: normal; margin-top: 10px; font-size: 12px; }
.lobby-shell__server-select .unity-base-popup-field__arrow { -unity-background-image-tint-color: var(--ss3d-text-tertiary); }

.lobby-shell__map-load-status {
    font-size: 12px; color: var(--ss3d-text-tertiary); white-space: nowrap;
    overflow: hidden; text-overflow: ellipsis; align-self: stretch; min-width: 0;
    margin: 4px 0 10px; padding: 0; flex-shrink: 0;
}
.lobby-shell__map-load-status--loading { color: var(--lobby-btn-amber); }
.lobby-shell__map-load-status--ready { color: var(--lobby-btn-green); }
.lobby-shell__map-load-status--failed { color: #d36b6b; }
/* The admin form lists why a map can't start, one reason per line: let it wrap instead of clipping to one line. */
.lobby-shell__map-load-status--detail { white-space: normal; overflow: visible; text-overflow: clip; }
.lobby-shell__panel-body .lobby-shell__map-load-status { -unity-text-align: middle-center; margin-bottom: 0; }
