<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- The character window, drawn as the UI bible's "character" tab: the old character setup screen's composition (title
         and rule, a tab column, labels over their controls, the framed viewport, a continue button). CharacterWindowView
         binds it by name, fills the panes and lays charwin-window out at 1200 × 675, scaled to the screen. -->
    <ui:VisualElement name="character-window-surface" class="lobby charwin lobby-theme" focusable="true">
        <!-- On the root, not the UXML: the view detaches this element from its TemplateContainer. -->
        <ui:Style src="project://database/Assets/Content/Systems/UI/Lobby/CharacterWindow.uss" />
        <ui:VisualElement class="charwin__veil" picking-mode="Ignore" />
        <ui:VisualElement name="charwin-window" class="charwin__window ui-select-host">
            <ui:Label text="character setup" class="charwin__title" picking-mode="Ignore" />
            <ui:VisualElement class="charwin__rule" picking-mode="Ignore" />

            <!-- Who you're editing: the switcher as the reference's dropdown, at the end of the title line. -->
            <ui:VisualElement class="charwin__who">
                <ui:Label text="character" class="charwin__who-label" picking-mode="Ignore" />
                <ui:Button name="charwin-switch" class="charwin__switch" tooltip="Switch character">
                    <ui:VisualElement name="charwin-switch-portrait" class="charwin__switch-portrait" picking-mode="Ignore" />
                    <ui:Label name="charwin-switch-name" text="Rory Lindqvist" class="charwin__switch-name" picking-mode="Ignore" />
                    <ui:Label name="charwin-switch-count" text="3/10" class="charwin__switch-count" picking-mode="Ignore" />
                    <ui:VisualElement class="charwin__arrow" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>

            <!-- Each tab: its accent bar (grown while selected) and its glyph. The look's tabs share one accent; Jobs takes
                 the High job's department and Antags danger (CharacterWindowView.RefreshTabMarks). -->
            <ui:VisualElement name="charwin-tabs" class="charwin__tabs">
                <ui:Button name="charwin-tab-profile" text="profile" class="charwin__tab">
                    <ui:VisualElement class="charwin__tab-bar" picking-mode="Ignore" />
                    <ui:VisualElement class="charwin__tab-icon charwin__tab-icon--profile" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="charwin-tab-body" text="body" class="charwin__tab">
                    <ui:VisualElement class="charwin__tab-bar" picking-mode="Ignore" />
                    <ui:VisualElement class="charwin__tab-icon charwin__tab-icon--body" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="charwin-tab-skin" text="skin &amp; eyes" class="charwin__tab">
                    <ui:VisualElement class="charwin__tab-bar" picking-mode="Ignore" />
                    <ui:VisualElement class="charwin__tab-icon charwin__tab-icon--skin" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="charwin-tab-hair" text="hair" class="charwin__tab">
                    <ui:VisualElement class="charwin__tab-bar" picking-mode="Ignore" />
                    <ui:VisualElement class="charwin__tab-icon charwin__tab-icon--hair" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="charwin-tab-beard" text="facial hair" class="charwin__tab">
                    <ui:VisualElement class="charwin__tab-bar" picking-mode="Ignore" />
                    <ui:VisualElement class="charwin__tab-icon charwin__tab-icon--beard" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="charwin-tab-jobs" text="jobs" class="charwin__tab charwin__tab--jobs">
                    <ui:VisualElement class="charwin__tab-bar" picking-mode="Ignore" />
                    <ui:VisualElement class="charwin__tab-icon charwin__tab-icon--jobs" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="charwin-tab-antags" text="antags" class="charwin__tab charwin__tab--antags">
                    <ui:VisualElement class="charwin__tab-bar" picking-mode="Ignore" />
                    <ui:VisualElement class="charwin__tab-icon charwin__tab-icon--antags" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>

            <!-- The centre column holds the appearance panes; Jobs and Antags need the width and take the viewport's place. -->
            <ui:VisualElement name="charwin-column" class="charwin__column" />
            <ui:VisualElement name="charwin-wide" class="charwin__wide" />

            <ui:VisualElement name="charwin-preview" class="charwin__frame" focusable="true" tooltip="Drag to turn. Q and E, or the arrow keys, turn it to a side.">
                <ui:VisualElement class="charwin__viewport" picking-mode="Ignore">
                    <ui:VisualElement name="charwin-preview-image" class="charwin__preview-image" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="charwin__under">
                <ui:VisualElement name="charwin-angles" class="charwin__seg">
                    <ui:Button name="charwin-angle-front" text="front" class="charwin__seg-option charwin__angle" tooltip="Front (Q / E)" />
                    <ui:Button name="charwin-angle-side" text="side" class="charwin__seg-option charwin__angle" tooltip="Side (Q / E)" />
                    <ui:Button name="charwin-angle-back" text="back" class="charwin__seg-option charwin__angle" tooltip="Back (Q / E)" />
                </ui:VisualElement>
                <ui:Label text="drag to turn" class="charwin__hint" picking-mode="Ignore" />
            </ui:VisualElement>

            <!-- Save state as an area (warn while unsaved), then the continue button: back to the lobby. Save turns into the
                 call to action while there is something valid to save, its ring breathing (UiMotion.Pulse). -->
            <ui:VisualElement name="charwin-status" class="charwin__save">
                <ui:VisualElement class="charwin__save-icon" picking-mode="Ignore" />
                <ui:Label name="charwin-status-label" text="saved" class="charwin__save-state" picking-mode="Ignore" />
                <ui:Button name="charwin-discard" text="discard" class="charwin__small" tooltip="Throw away the unsaved changes" />
                <!-- A Button with children stops measuring its own text: the label is a child, so it sizes the button. -->
                <ui:Button name="charwin-save" class="charwin__small charwin__save-button">
                    <ui:Label text="save" class="charwin__save-label" picking-mode="Ignore" />
                    <ui:VisualElement name="charwin-save-ring" class="charwin__save-ring" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
            <ui:Button name="charwin-return" class="charwin__continue" tooltip="Return to the lobby (Esc)">
                <ui:VisualElement class="charwin__continue-tip" picking-mode="Ignore" />
                <ui:Label text="return to lobby" class="charwin__continue-text" picking-mode="Ignore" />
            </ui:Button>

            <ui:VisualElement name="charwin-prompt" class="lobby-prompt charwin__prompt">
                <ui:VisualElement class="lobby-prompt__card">
                    <ui:Label text="UNSAVED CHANGES" class="lobby-prompt__title lb-titling" />
                    <ui:Label name="charwin-prompt-text" text="Save your changes to this character before you leave?" class="lobby-prompt__text" />
                    <ui:Label name="charwin-prompt-error" class="lobby-prompt__error" />
                    <ui:VisualElement class="lobby-prompt__buttons">
                        <ui:Button name="charwin-prompt-keep" text="KEEP EDITING" class="lobby-admin__button lb-titling" />
                        <ui:Button name="charwin-prompt-discard" text="DISCARD" class="lobby-admin__button lobby-admin__button--danger lb-titling" />
                        <ui:Button name="charwin-prompt-save" text="SAVE" class="lobby-admin__button lobby-admin__button--start lb-titling" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
