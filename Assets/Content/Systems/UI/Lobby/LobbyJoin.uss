/*
 * Join picker (lobby.md §7), drawn with the UI bible's parts (Documents/plans/assets/ui-bible, "lobby" tab; its
 * components.css join-picker section, and the join rules of its "Lobby: colour coding" block, are this sheet line for
 * line, in USS). It sits in the lobby shell (Lobby.uxml, lobby-join); Lobby.uss imports it after ui-tokens.uss.
 *   card       a floating plate (--ui-float) over the dimmed lobby
 *   jobs       tints, each with its department's 3 px left edge, glyph cell and name. The picked job outlines in its
 *              department's colour and fills its ring; Join is the white plate, filled with that colour once a job is
 *              picked
 *   manifest   department groups with the edge and a coloured name; a gap ("No Doctor aboard") is news, in info
 * Sizes are the bible's reference px: the lobby root is laid out at 1200 × 675 and scaled to the screen in C#.
 * Labels are Disket Mono Bold, which draws only capitals; text is Kode Mono. Labels that carry .lb-titling or .lb-mono
 * set their font here, so the bible's font wins.
 * --dept comes from the .lb-dept--<department> classes (Lobby.uss) that LobbyJoinPicker puts on a job item, its glyph
 * cell, Join and a manifest group. A job or group with no department reads the neutral default set on .lobby-join.
 * Rules are prefixed with .lobby so they beat the runtime theme and the shell's resets. Buttons keep the theme's
 * .unity-button class, so every Button class here sets its own background, border and colour for :hover and :active
 * too, or the theme's light grey shows through.
 */

/* ── Join picker: a floating plate over the lobby ── */
.lobby .lobby-join {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.35);
    display: none;
    /* Neutral, for a job the server and the roster don't place in a department ("Other"). */
    --dept: rgba(255, 255, 255, 0.5);
}

.lobby .lobby-join--open {
    display: flex;
}

.lobby .lobby-join .unity-disabled {
    opacity: 1;
}

/* No overflow: hidden here: with border-radius it renders the whole card white. */
.lobby .lobby-join__card {
    width: 1040px;
    height: 600px;
    max-width: 96%;
    max-height: 94%;
    background-color: var(--ui-float);
    border-width: var(--ui-hairline);
    border-color: var(--ui-panel-edge);
    border-radius: var(--ui-panel-radius);
}

/* ── Thin scrollers: the map editor's ── */
.lobby .lobby-join .unity-scroller--vertical {
    width: 6px;
    min-width: 6px;
    margin-left: 2px;
}

.lobby .lobby-join .unity-scroller--vertical .unity-scroller__low-button,
.lobby .lobby-join .unity-scroller--vertical .unity-scroller__high-button {
    display: none;
}

.lobby .lobby-join .unity-scroller--vertical .unity-scroller__slider {
    width: 6px;
    min-width: 6px;
    margin: 0;
}

.lobby .lobby-join .unity-scroller--vertical .unity-base-slider__tracker {
    width: 6px;
    left: 0;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0);
}

.lobby .lobby-join .unity-scroller--vertical .unity-base-slider__dragger {
    width: 6px;
    left: 0;
    margin-left: 0;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.22);
}

.lobby .lobby-join .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: rgba(255, 255, 255, 0.4);
}

.lobby .lobby-join .unity-scroller--vertical .unity-base-slider__dragger-border {
    display: none;
}

/* ── Header ── */
.lobby .lobby-join__header {
    flex-direction: row;
    align-items: center;
    height: 52px;
    flex-shrink: 0;
    padding: 0 12px 0 20px;
}

.lobby .lobby-join__title {
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 17px;
}

.lobby .lobby-join__meta-key {
    margin-left: 18px;
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 9px;
    color: rgba(255, 255, 255, 0.45);
}

.lobby .lobby-join__clock {
    margin-left: 6px;
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/KodeMonoSDF.asset");
    font-size: 12px;
}

/* Close: the main menu's glyph cell. */
.lobby .lobby-join__close,
.lobby .lobby-join__close:active,
.lobby .lobby-join__close:hover:active {
    background-color: rgba(0, 0, 0, 0);
}

.lobby .lobby-join__close {
    width: 28px;
    height: 28px;
    margin: 0 0 0 6px;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: var(--ui-hairline);
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4.2px; /* 15 % */
}

.lobby .lobby-join__close:hover {
    border-color: var(--ui-editor-cell-edge);
    background-color: rgba(0, 0, 0, 0);
}

.lobby .lobby-join__close .lobby__icon {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.55);
}

.lobby .lobby-join__close:hover .lobby__icon {
    -unity-background-image-tint-color: var(--ui-text);
}

.lobby .lobby-join__body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

/* ── Open jobs ── */
.lobby .lobby-join__jobs {
    width: 440px;
    flex-shrink: 0;
    padding: 4px 20px 20px 20px;
}

.lobby .lobby-join__section-head {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 20px;
    margin-bottom: 8px;
}

.lobby .lobby-join__section-title {
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 10px;
    color: rgba(255, 255, 255, 0.5);
}

.lobby .lobby-join__section-count {
    margin-left: 8px;
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/KodeMonoSDF.asset");
    font-size: 10.5px;
    color: rgba(255, 255, 255, 0.5);
}

.lobby .lobby-join__hint {
    font-size: 10.5px;
    color: rgba(255, 255, 255, 0.45);
}

.lobby .lobby-join__empty {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.5);
    white-space: normal;
}

/* A notice: news in the info colour (only Assistant is open), the job you picked filling in warn. */
.lobby .lobby-join__notice {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    padding: 8px 10px;
    flex-shrink: 0;
    border-width: var(--ui-hairline);
    border-color: var(--ui-info);
    background-color: rgba(120, 196, 236, 0.08);
}

.lobby .lobby-join__notice .lobby__icon {
    margin-right: 10px;
    -unity-background-image-tint-color: var(--ui-info);
}

.lobby .lobby-join__notice-text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.85);
    white-space: normal;
}

.lobby .lobby-join__notice--warning {
    border-color: var(--ui-warn);
    background-color: rgba(238, 186, 78, 0.08);
}

.lobby .lobby-join__notice--warning .lobby__icon {
    -unity-background-image-tint-color: var(--ui-warn);
}

.lobby .lobby-join__notice--hidden {
    display: none;
}

.lobby .lobby-join__job-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.lobby .lobby-join__job-item {
    margin-bottom: 4px;
    flex-shrink: 0;
}

/* A job: a tint. Picked, it takes the white outline (the active hand's line); the ring fills. */
.lobby .lobby-join__job {
    flex-direction: row;
    align-items: center;
    height: 46px;
    margin: 0;
    padding: 0 12px;
    flex-shrink: 0;
    background-color: var(--ui-editor-button);
    border-width: var(--ui-hairline);
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    color: var(--ui-text);
    transition-property: background-color, border-color;
    transition-duration: 0.09s;
}

.lobby .lobby-join__job:hover,
.lobby .lobby-join__job:active,
.lobby .lobby-join__job:hover:active {
    background-color: var(--ui-editor-button-hover);
    border-color: rgba(0, 0, 0, 0);
    color: var(--ui-text);
}

.lobby .lobby-join__job-item--on .lobby-join__job,
.lobby .lobby-join__job-item--on .lobby-join__job:hover,
.lobby .lobby-join__job-item--on .lobby-join__job:active,
.lobby .lobby-join__job-item--on .lobby-join__job:hover:active {
    border-color: var(--ui-line-active);
}

.lobby .lobby-join__ring {
    width: 14px;
    height: 14px;
    margin-right: 12px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-width: var(--ui-hairline);
    border-color: rgba(255, 255, 255, 0.35);
    border-radius: 7px;
}

.lobby .lobby-join__ring-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
}

.lobby .lobby-join__job-item--on .lobby-join__ring {
    border-color: var(--ui-text);
}

.lobby .lobby-join__job-item--on .lobby-join__ring-dot {
    background-color: var(--ui-text);
}

/* The job's glyph in a storage cell outlined in its department's colour (the map editor's category coding). */
.lobby .lobby-join__job-frame {
    width: 30px;
    height: 30px;
    margin-right: 10px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-width: var(--ui-hairline);
    border-color: var(--dept);
    border-radius: 4.5px; /* 15 % */
    background-color: rgba(0, 0, 0, 0.35);
}

.lobby .lobby-join__job-frame .lobby__icon {
    width: 18px;
    height: 18px;
}

.lobby .lobby-join__job-text {
    flex-shrink: 1;
}

.lobby .lobby-join__job-name {
    font-size: 13px;
    color: var(--ui-text);
}

.lobby .lobby-join__job-dept {
    margin-top: 5px;
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 9px;
}

/* The bible's .lb-dept-text, held here as well: a department's name in its colour. */
.lobby .lobby-join__job-dept.lb-dept-text {
    color: var(--dept);
}

.lobby .lobby-join__job-count {
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/KodeMonoSDF.asset");
    font-size: 12px;
    color: var(--ui-text);
}

.lobby .lobby-join__job-count-word {
    margin-left: 6px;
    font-size: 10.5px;
    color: rgba(255, 255, 255, 0.5);
}

.lobby .lobby-join__description {
    margin-top: 2px;
    padding: 8px 12px 9px 38px;
    background-color: rgba(255, 255, 255, 0.035);
    font-size: 11px;
    color: rgba(255, 255, 255, 0.75);
    white-space: normal;
}

/* ── Joining as ── */
.lobby .lobby-join__as {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-top: 8px;
    padding: 6px 8px;
    background-color: var(--ui-editor-button);
}

.lobby .lobby-join__portrait-frame {
    width: 28px;
    height: 38px;
    margin-right: 10px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-width: var(--ui-hairline);
    border-color: var(--ui-editor-cell-edge);
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0.6);
}

/* The character's live render fills the cell (the bible draws a silhouette where it goes). */
.lobby .lobby-join__portrait {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.lobby .lobby-join__as-text {
    flex-grow: 1;
    flex-shrink: 1;
}

.lobby .lobby-join__as-text > .lobby__eyebrow {
    font-size: 9px;
}

.lobby .lobby-join__character {
    margin-top: 5px;
    font-size: 12.5px;
}

.lobby .lobby-join__change {
    flex-direction: row;
    align-items: center;
    height: 28px;
    margin: 0;
    padding: 0 10px;
    flex-shrink: 0;
    border-width: 0;
    border-radius: 0;
    background-color: var(--ui-editor-button);
    color: var(--ui-text);
}

.lobby .lobby-join__change:hover,
.lobby .lobby-join__change:active,
.lobby .lobby-join__change:hover:active {
    background-color: var(--ui-editor-button-hover);
    color: var(--ui-text);
}

.lobby .lobby-join__change .lobby__icon {
    width: 13px;
    height: 13px;
    margin-right: 8px;
    -unity-background-image-tint-color: var(--ui-text);
}

.lobby .lobby-join__change-label {
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 10px;
    color: var(--ui-text);
}

/* ── Join: the white plate, as Ready ── */
.lobby .lobby-join__confirm {
    flex-direction: row;
    align-items: center;
    height: 52px;
    margin: 8px 0 0 0;
    padding: 0 14px;
    flex-shrink: 0;
    border-width: 0;
    border-radius: 0;
    background-color: var(--ui-menu-selected);
    color: var(--ui-text-on-light);
    transition-property: background-color;
    transition-duration: 0.09s;
}

.lobby .lobby-join__confirm:hover {
    background-color: rgb(255, 255, 255);
    color: var(--ui-text-on-light);
}

.lobby .lobby-join__confirm:active,
.lobby .lobby-join__confirm:hover:active {
    background-color: rgb(207, 207, 204);
    color: var(--ui-text-on-light);
}

.lobby .lobby-join__confirm-text {
    flex-grow: 1;
}

.lobby .lobby-join__confirm-title {
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 16px;
    color: var(--ui-text-on-light);
}

.lobby .lobby-join__confirm-subtitle {
    margin-top: 7px;
    font-size: 10.5px;
    color: rgba(13, 13, 13, 0.6);
}

.lobby .lobby-join__confirm .lobby__keycap {
    background-color: rgba(0, 0, 0, 0.12);
    color: rgba(13, 13, 13, 0.7);
}

/* ── The crew manifest: departments as tinted groups, two columns ── */
.lobby .lobby-join__manifest-section {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    padding: 4px 20px 20px 0;
}

.lobby .lobby-join__manifest-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.lobby .lobby-join__manifest {
    flex-direction: row;
    align-items: flex-start;
}

.lobby .lobby-join__column {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
}

.lobby .lobby-join__column--left {
    margin-right: 8px;
}

.lobby .lobby-join__group {
    margin-bottom: 6px;
    flex-shrink: 0;
    background-color: var(--ui-editor-button);
}

.lobby .lobby-join__group-head {
    flex-direction: row;
    align-items: center;
    height: 30px;
    padding: 0 10px;
}

.lobby .lobby-join__group-head .lobby-join__group-icon {
    width: 14px;
    height: 14px;
    margin-right: 8px;
}

.lobby .lobby-join__group-name {
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 10px;
}

.lobby .lobby-join__group-count {
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/KodeMonoSDF.asset");
    font-size: 10.5px;
    color: rgba(255, 255, 255, 0.5);
}

.lobby .lobby-join__crew {
    flex-direction: row;
    justify-content: space-between;
    padding: 6px 10px;
    border-top-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
}

.lobby .lobby-join__crew-name {
    flex-shrink: 1;
    font-size: 11.5px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.lobby .lobby-join__crew-job {
    margin-left: 12px;
    flex-shrink: 0;
    font-size: 10.5px;
    color: rgba(255, 255, 255, 0.5);
}

/* A gap a latejoiner could fill ("No Doctor aboard"): news, so the info colour. */
.lobby .lobby-join__crew-missing {
    padding: 6px 10px;
    border-top-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    font-size: 11px;
    color: var(--ui-info);
}

/* ── Colour coding ──
 * A job: its department's edge; picked, the whole outline and the ring in that colour; Join fills with it. */
.lobby .lobby-join__job,
.lobby .lobby-join__job:hover,
.lobby .lobby-join__job:active,
.lobby .lobby-join__job:hover:active {
    border-left-width: 3px;
    border-left-color: var(--dept);
}

.lobby .lobby-join__job-item--on .lobby-join__job,
.lobby .lobby-join__job-item--on .lobby-join__job:hover,
.lobby .lobby-join__job-item--on .lobby-join__job:active,
.lobby .lobby-join__job-item--on .lobby-join__job:hover:active {
    border-color: var(--dept);
}

.lobby .lobby-join__job-item--on .lobby-join__ring {
    border-color: var(--dept);
}

.lobby .lobby-join__job-item--on .lobby-join__ring-dot {
    background-color: var(--dept);
}

.lobby .lobby-join__description {
    border-left-width: 3px;
    border-color: var(--dept);
}

.lobby .lobby-join__confirm.lobby-join__confirm--dept,
.lobby .lobby-join__confirm.lobby-join__confirm--dept:hover,
.lobby .lobby-join__confirm.lobby-join__confirm--dept:active,
.lobby .lobby-join__confirm.lobby-join__confirm--dept:hover:active {
    background-color: var(--dept);
    color: var(--ui-text-on-light);
}

.lobby .lobby-join__confirm.lobby-join__confirm--dept:active,
.lobby .lobby-join__confirm.lobby-join__confirm--dept:hover:active {
    opacity: 0.85;
}

/* The manifest: each department's group carries its edge, glyph and name. */
.lobby .lobby-join__group {
    border-left-width: 3px;
    border-color: var(--dept);
}

.lobby .lobby-join__group-name {
    color: var(--dept);
}

/* ── Join off: nothing picked, or waiting for the spawn after a press. It fades, over the department's fill too
 * (the bible's --disabled; here the Button's :disabled, after the colour coding so it wins). ── */
.lobby .lobby-join__confirm:disabled,
.lobby .lobby-join__confirm:disabled:hover,
.lobby .lobby-join__confirm.lobby-join__confirm--dept:disabled,
.lobby .lobby-join__confirm.lobby-join__confirm--dept:disabled:hover {
    background-color: rgba(255, 255, 255, 0.03);
    color: var(--ui-menu-tab-text);
    opacity: 1;
}

.lobby .lobby-join__confirm:disabled .lobby-join__confirm-title,
.lobby .lobby-join__confirm:disabled .lobby-join__confirm-subtitle,
.lobby .lobby-join__confirm:disabled .lobby__keycap {
    color: var(--ui-menu-tab-text);
}

.lobby .lobby-join__confirm:disabled .lobby__keycap {
    background-color: rgba(0, 0, 0, 0.3);
}
