.hands-gear-strip {
    flex-direction: row;
    align-items: flex-end;
}

.hands-gear-strip__gear {
    flex-direction: row;
    padding-bottom: 4px;
}

.hands-gear-strip__gear > .inventory-slot {
    margin-left: var(--ss3d-space-1);
}

.hands-gear-strip__divider {
    width: 1px;
    height: 56px;
    background-color: var(--ss3d-border-default);
    margin-left: var(--ss3d-space-2);
    margin-right: var(--ss3d-space-2);
}

.hands-gear-strip__hands {
    flex-direction: row;
}

.hands-gear-strip__hands > .inventory-slot {
    margin-left: var(--ss3d-space-2);
}
