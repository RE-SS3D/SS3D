.self-examine {
    flex-direction: row;
    gap: 20px;
}

.self-examine__column {
    width: 220px;
}

.self-examine__heading {
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--ss3d-text-secondary);
    margin-bottom: var(--ss3d-space-2);
}

.self-examine__limb-row {
    flex-direction: row;
    justify-content: space-between;
    font-size: 11px;
    color: var(--ss3d-text-tertiary);
    margin-bottom: 5px;
}

.self-examine__divider {
    width: 1px;
    background-color: var(--ss3d-border-default);
}

.self-examine__organ {
    margin-bottom: var(--ss3d-space-2);
}

.self-examine__organ-label-row {
    flex-direction: row;
    justify-content: space-between;
    font-size: 11px;
    color: var(--ss3d-text-secondary);
    margin-bottom: 3px;
}

.self-examine__organ-label-row--warning {
    color: var(--ss3d-feedback-warning);
}

.self-examine__organ-label-row--critical {
    color: var(--ss3d-feedback-danger);
}

.self-examine__organ-bar-track {
    height: 5px;
    background-color: var(--ss3d-surface-inset);
    border-radius: var(--ss3d-radius-sm);
    overflow: hidden;
}

.self-examine__organ-bar-fill {
    height: 100%;
    background-color: var(--ss3d-feedback-success);
}

.self-examine__organ-bar-fill--warning {
    background-color: var(--ss3d-feedback-warning);
}

.self-examine__organ-bar-fill--critical {
    background-color: var(--ss3d-feedback-danger);
}
