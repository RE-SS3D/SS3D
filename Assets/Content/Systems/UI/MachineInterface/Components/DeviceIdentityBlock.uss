
.device-identity-block {
    flex-direction: column;
    margin-bottom: 14px;
}

.device-identity-block__title {
    font-size: 22px;
    letter-spacing: 3px;
    color: var(--ss3d-text-primary);
    -unity-text-align: upper-left;
    white-space: normal;
}

.device-identity-block__subtitle {
    font-size: 13px;
    color: var(--ss3d-text-secondary);
    margin-top: 4px;
    white-space: normal;
}

.device-identity-block__metadata {
    font-size: 12px;
    color: var(--ss3d-text-tertiary);
    margin-top: 4px;
    white-space: normal;
}
