
.toggle-switch {
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
}

.toggle-switch--horizontal {
    flex-direction: row;
    align-items: center;
}

.toggle-switch--horizontal .toggle-switch__label {
    margin-bottom: 0;
    margin-right: 8px;
}

.toggle-switch__label {
    font-size: 9px;
    letter-spacing: 2px;
    color: var(--ss3d-text-secondary);
    margin-bottom: 6px;
}

.toggle-switch__track {
    position: relative;
    width: 56px;
    height: 30px;
    background-color: var(--ss3d-surface-inset);
    border-width: 1px;
    border-color: var(--ss3d-border-strong);
    border-radius: var(--ss3d-radius-sm);
    flex-shrink: 0;
}

.toggle-switch__track--on {
    border-color: var(--ss3d-accent-rust);
}

.toggle-switch__thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 24px;
    height: 24px;
    border-radius: var(--ss3d-radius-sm);
    background-color: var(--ss3d-ramp-steel-500, #6b6b70);
}

.toggle-switch--on .toggle-switch__thumb {
    left: 30px;
    background-color: var(--ss3d-accent-rust);
}

.toggle-switch--locked {
    opacity: 0.45;
}
