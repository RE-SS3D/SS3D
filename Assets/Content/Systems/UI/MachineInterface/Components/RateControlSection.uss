@import url("../Tokens/ss3d-tokens.uss");

.rate-control {
    flex-direction: column;
    width: 100%;
    padding-top: var(--ss3d-space-2);
    border-top-width: 1px;
    border-top-color: var(--ss3d-border-subtle);
}

.rate-control__bar-row,
.rate-control__stepper-row {
    margin-top: var(--ss3d-space-2);
}

.rate-control__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
}

.rate-control__title {
    flex-shrink: 1;
    font-size: 13px;
    letter-spacing: 2px;
    color: var(--ss3d-text-secondary);
}

.rate-control__bar-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
}

.rate-control__track {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 10px;
    background-color: var(--ss3d-surface-inset);
    border-width: 1px;
    border-color: var(--ss3d-border-subtle);
    border-radius: var(--ss3d-radius-sm);
    overflow: hidden;
}

.rate-control__fill {
    height: 100%;
}

.rate-control__fill.tone-success {
    background-color: var(--ss3d-feedback-success);
}

.rate-control__fill.tone-warning {
    background-color: var(--ss3d-feedback-warning);
}

.rate-control__fill.tone-danger {
    background-color: var(--ss3d-feedback-danger);
}

.rate-control__current {
    flex-shrink: 0;
    margin-left: var(--ss3d-space-3);
    font-size: 13px;
    color: var(--ss3d-text-primary);
    min-width: 56px;
}

.rate-control__stepper-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
}

.rate-control__stepper-hint {
    flex-shrink: 1;
    font-size: 11px;
    color: var(--ss3d-text-tertiary);
}

.rate-control__stepper {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

.rate-control .toggle-pill__button {
    min-width: 72px;
}

.rate-control__stepper-button {
    width: 22px;
    height: 22px;
    min-width: 22px;
    padding: 0;
    border-width: 1px;
    border-color: var(--ss3d-border-subtle);
    border-radius: var(--ss3d-radius-sm);
    background-color: var(--ss3d-surface-inset);
    color: var(--ss3d-text-secondary);
    font-size: 12px;
}

.rate-control__max {
    width: 52px;
    margin-left: 6px;
    margin-right: 6px;
    -unity-text-align: middle-center;
    font-size: 12px;
    color: var(--ss3d-text-primary);
}
