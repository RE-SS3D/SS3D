
.gas-bar-row {
    flex-direction: row;
    align-items: center;
}

.gas-bar-row__label {
    width: 60px;
    flex-shrink: 0;
    font-size: 13px;
    color: var(--ss3d-text-secondary);
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
}

.gas-bar-row__track {
    flex-grow: 1;
    height: 8px;
    margin-right: 10px;
    margin-left: 0;
    background-color: var(--ss3d-diegetic-inset);
    border-width: 1px;
    border-color: var(--ss3d-border-subtle);
    border-radius: var(--ss3d-radius-sm);
}

.gas-bar-row__track-clip {
    flex-grow: 1;
    height: 100%;
    overflow: hidden;
    border-radius: var(--ss3d-radius-sm);
}

.gas-bar-row__fill {
    height: 100%;
    background-color: #8a8d92;
}

.gas-bar-row__fill--accent {
    background-color: var(--ss3d-accent-rust);
}

.gas-bar-row__fill.tone-warning {
    background-color: var(--ss3d-feedback-warning);
}

.gas-bar-row__fill.tone-danger {
    background-color: var(--ss3d-feedback-danger);
}

.gas-bar-row__value {
    width: 52px;
    flex-shrink: 0;
    font-size: 13px;
    color: var(--ss3d-text-primary);
    -unity-text-align: middle-right;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
}

.panel-section__content .gas-bar-row__label,
.panel-section__content .gas-bar-row__value {
    background-color: rgba(0, 0, 0, 0);
}
