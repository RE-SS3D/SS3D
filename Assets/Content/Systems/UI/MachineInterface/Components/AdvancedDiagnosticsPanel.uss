@import url("../Tokens/ss3d-tokens.uss");

.advanced-diagnostics {
    flex-direction: column;
    gap: var(--ss3d-space-3);
    padding: var(--ss3d-space-3);
    background-color: var(--ss3d-surface-inset);
    border-width: 1px;
    border-color: var(--ss3d-border-accent);
    border-radius: var(--ss3d-radius-md);
    margin-top: var(--ss3d-space-2);
}

.advanced-diagnostics__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.advanced-diagnostics__title {
    font-size: 13px;
    letter-spacing: 2px;
    color: var(--ss3d-text-primary);
}

.advanced-diagnostics__hide {
    border-width: 0;
    background-color: transparent;
    color: var(--ss3d-text-tertiary);
    font-size: 11px;
    padding: 0;
}

.advanced-diagnostics__metrics {
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--ss3d-space-2);
}

.advanced-diagnostics__metric {
    width: 48%;
    flex-direction: column;
    gap: 1px;
}

.advanced-diagnostics__metric-label {
    font-size: 8.5px;
    letter-spacing: 1px;
    color: var(--ss3d-text-tertiary);
}

.advanced-diagnostics__metric-value {
    font-size: 13px;
    color: var(--ss3d-text-primary);
}

.advanced-diagnostics__maintenance {
    flex-direction: column;
    gap: 4px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: var(--ss3d-border-subtle);
}

.advanced-diagnostics__maintenance-label {
    font-size: 8.5px;
    letter-spacing: 1px;
    color: var(--ss3d-text-tertiary);
}

.advanced-diagnostics__maintenance-value {
    font-size: 12px;
    color: var(--ss3d-text-tertiary);
}
