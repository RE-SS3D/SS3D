
.access-strip {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: var(--ss3d-surface-inset);
    border-radius: var(--ss3d-radius-sm);
    padding: 8px 12px;
    margin-bottom: 14px;
}

.access-strip .steel-button__control {
    min-height: 32px;
    min-width: 120px;
}
