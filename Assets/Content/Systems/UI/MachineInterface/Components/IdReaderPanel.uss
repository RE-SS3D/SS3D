@import url("../Tokens/diegetic-tokens.uss");
@import url("../../Tokens/ss3d-typography.uss");

.id-reader-panel__body {
    flex-direction: column;
}

.id-reader-panel__status {
    font-size: 13px;
    color: var(--ss3d-text-primary);
}

.id-reader-panel__sub {
    font-size: 10.5px;
    color: var(--ss3d-text-tertiary);
    margin-top: 2px;
    margin-bottom: 10px;
}
