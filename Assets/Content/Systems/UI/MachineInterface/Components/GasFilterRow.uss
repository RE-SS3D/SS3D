
.gas-filter-row {
    flex-direction: row;
    align-items: center;
    width: 49%;
    margin-bottom: 8px;
    padding: 8px 10px;
    background-color: var(--ss3d-diegetic-inset);
    border-width: 1px;
    border-color: var(--ss3d-border-subtle);
    border-radius: var(--ss3d-radius-sm);
}

.gas-filter-row--on {
    border-color: var(--ss3d-accent-rust);
}

.gas-filter-row--locked {
    opacity: 0.45;
}

.gas-filter-row__track {
    position: relative;
    width: 44px;
    height: 24px;
    flex-shrink: 0;
    margin-right: 10px;
    background-color: var(--ss3d-diegetic-screen-bg);
    border-width: 1px;
    border-color: var(--ss3d-border-strong);
    border-radius: var(--ss3d-radius-sm);
}

.gas-filter-row__thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 18px;
    height: 18px;
    border-radius: var(--ss3d-radius-sm);
    background-color: #6b6b70;
}

.gas-filter-row--on .gas-filter-row__thumb {
    left: 22px;
    background-color: var(--ss3d-accent-rust);
}

.gas-filter-row__swatch {
    width: 8px;
    height: 8px;
    flex-shrink: 0;
    margin-right: 10px;
    border-radius: 1px;
}

.gas-filter-row__names {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    flex-direction: column;
}

.gas-filter-row__symbol {
    font-size: 13px;
    color: var(--ss3d-text-primary);
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
}

.gas-filter-row__name {
    font-size: 11px;
    color: var(--ss3d-text-tertiary);
    padding: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    background-color: rgba(0, 0, 0, 0);
}

.gas-filter-row__percent {
    font-size: 12px;
    margin-left: 8px;
    color: var(--ss3d-text-tertiary);
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
}

.gas-filter-row--present .gas-filter-row__percent {
    color: var(--ss3d-text-secondary);
}

.gas-filter-row--present.gas-filter-row--on .gas-filter-row__percent {
    color: var(--ss3d-accent-rust);
}
