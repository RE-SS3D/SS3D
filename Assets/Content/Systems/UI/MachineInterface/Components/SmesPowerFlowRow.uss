@import url("../Tokens/ss3d-tokens.uss");
@import url("../Tokens/ss3d-typography.uss");

.smes-power-flow-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.smes-power-flow-row__node {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    -unity-text-align: middle-center;
    padding: 12px 8px;
    background-color: var(--ss3d-surface-inset);
    border-radius: var(--ss3d-radius-sm);
    font-size: 12px;
    color: var(--ss3d-text-secondary);
}

.smes-power-flow-row__node--core {
    background-color: var(--ss3d-surface-panel);
    border-width: 1px;
    border-color: var(--ss3d-border-accent);
    color: var(--ss3d-text-primary);
    font-size: 13px;
    padding: 12px 8px;
}

.smes-power-flow-row__glyph {
    width: 34px;
    flex-shrink: 0;
    font-size: 18px;
    -unity-text-align: middle-center;
}

.smes-power-flow-row__glyph.tone-success {
    color: var(--ss3d-feedback-success);
}

.smes-power-flow-row__glyph.tone-warning {
    color: var(--ss3d-feedback-warning);
}

.smes-power-flow-row__glyph.tone-danger {
    color: var(--ss3d-feedback-danger);
}

.smes-power-flow-row__glyph.tone-info {
    color: var(--ss3d-text-tertiary);
}
