
.pressure-flow-readout {
    flex-direction: row;
    align-items: center;
}

.panel-section__content .pressure-flow-readout__node {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    padding: 12px 8px;
    background-color: var(--ss3d-diegetic-inset);
    border-radius: var(--ss3d-radius-sm);
    align-items: center;
}

.panel-section__content .pressure-flow-readout__node--core {
    background-color: var(--ss3d-diegetic-panel-raised);
    border-width: 1px;
    border-color: var(--ss3d-border-default);
}

.pressure-flow-readout__node-title {
    font-size: 9px;
    letter-spacing: 2px;
    color: var(--ss3d-text-tertiary);
    margin-bottom: 4px;
    padding: 0;
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0);
}

.pressure-flow-readout__node-value {
    font-size: 16px;
    color: var(--ss3d-text-primary);
    padding: 0;
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0);
}

.pressure-flow-readout__glyph {
    width: 40px;
    flex-shrink: 0;
    font-size: 18px;
    -unity-text-align: middle-center;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
}

.panel-section__content .pressure-flow-readout__node-title,
.panel-section__content .pressure-flow-readout__node-value,
.panel-section__content .pressure-flow-readout__glyph {
    background-color: rgba(0, 0, 0, 0);
}
