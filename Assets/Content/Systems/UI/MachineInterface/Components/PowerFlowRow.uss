@import url("../Tokens/ss3d-tokens.uss");
@import url("../Tokens/ss3d-typography.uss");

.power-flow-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: var(--ss3d-surface-inset);
    border-radius: var(--ss3d-radius-sm);
    border-width: 1px;
    border-color: var(--ss3d-border-subtle);
    padding: var(--ss3d-space-3) var(--ss3d-space-4);
    margin-bottom: var(--ss3d-space-3);
}

.power-flow-row__metric {
    flex-direction: column;
    flex-grow: 1;
}

.power-flow-row__label {
    font-size: 9px;
    color: var(--ss3d-text-tertiary);
    letter-spacing: 2px;
    margin-bottom: var(--ss3d-space-1);
}

.power-flow-row__value {
    font-size: 18px;
    color: var(--ss3d-text-primary);
}

.power-flow-row__unit {
    font-size: 10px;
    color: var(--ss3d-text-secondary);
    margin-left: var(--ss3d-space-1);
}

.power-flow-row__arrow {
    font-size: 20px;
    color: var(--ss3d-accent-rust);
    margin-left: var(--ss3d-space-3);
    margin-right: var(--ss3d-space-3);
    -unity-text-align: middle-center;
    min-width: 32px;
}

.power-flow-row__metric--output {
    align-items: flex-end;
}

.power-flow-row__value-row {
    flex-direction: row;
    align-items: flex-end;
}
