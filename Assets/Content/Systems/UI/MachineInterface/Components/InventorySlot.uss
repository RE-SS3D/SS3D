
.inventory-slot {
    flex-direction: column;
    align-items: center;
}

.inventory-slot__well {
    background-color: var(--ss3d-diegetic-inset);
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--ss3d-border-subtle);
    align-items: center;
    justify-content: center;
}

.inventory-slot--unknown .inventory-slot__well {
    background-color: var(--ss3d-diegetic-panel-raised);
}

.inventory-slot__unknown-glyph {
    font-size: 22px;
    color: var(--ss3d-text-tertiary);
    display: none;
}

.inventory-slot__icon {
    width: 62%;
    height: 62%;
    display: none;
    -unity-background-scale-mode: scale-to-fit;
}

.inventory-slot__icon--placeholder {
    opacity: 0.65;
}

.inventory-slot__label-host {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 4px;
}

.inventory-slot__label {
    font-size: 10px;
    color: var(--ss3d-text-tertiary);
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 64px;
}

.inventory-slot--valid-drop .inventory-slot__well {
    border-color: var(--ss3d-feedback-info);
    background-color: var(--ss3d-feedback-info-bg);
}

.inventory-slot--invalid-drop .inventory-slot__well {
    border-color: var(--ss3d-feedback-danger);
    background-color: var(--ss3d-feedback-danger-bg);
}
