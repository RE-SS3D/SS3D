
.panel-section {
    flex-direction: column;
    background-color: var(--ss3d-diegetic-panel-body);
    border-radius: var(--ss3d-radius-md);
    border-width: 1px;
    border-color: var(--ss3d-diegetic-panel-raised);
    margin-bottom: 14px;
    flex-shrink: 0;
}

.panel-section__clip {
    flex-direction: column;
    overflow: hidden;
}

.panel-section__header {
    background-color: var(--ss3d-diegetic-panel-raised);
    padding: 8px 14px;
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--ss3d-text-primary);
    -unity-text-align: middle-left;
}

.panel-section__header--split {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.panel-section__header-title {
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--ss3d-text-primary);
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
}

.panel-section__content {
    flex-direction: column;
    padding: 14px;
    background-color: var(--ss3d-diegetic-panel-body);
}

.panel-section__content Label {
    background-color: rgba(0, 0, 0, 0);
}
