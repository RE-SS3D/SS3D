<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:ss3d="SS3D.UI.MachineInterface.Components" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/Content/Systems/UI/Tokens/ss3d-tokens.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/Tokens/ss3d-typography.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Tokens/diegetic-tokens.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Tokens/diegetic-tones.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/DiegeticDeviceShell.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/StatusDot.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/ConnectionStatusRow.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/DeviceIdentityBlock.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/GlanceableStatusChip.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/PanelSection.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/PowerFlowRow.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/BatteryBar.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/DiagnosticsList.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/ChannelRow.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/ToggleSwitch.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/AccessGatePanel.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/AccessGatedRegion.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/AccessStrip.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/SteelButton.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/Badge.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/StatusBadge.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/DeviceFooter.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Templates/ApcPowerController.uss" />

    <ss3d:DiegeticDeviceShell name="device-shell"
        class="diegetic-device-shell--apc"
        model-label="APC-7 · area power controller"
        power-ok="true"
        style="align-self: center; margin-top: 24px;">
        <ss3d:ConnectionStatusRow name="connection-row"
            status-text="WIRED · POWER NET · NODE E-12"
            readout-text="GRID FEED NOMINAL" />
        <ui:VisualElement class="apc-identity-row">
            <ss3d:DeviceIdentityBlock name="identity"
                title="APC-ENG-03"
                subtitle="Engineering Bay 3" />
            <ss3d:GlanceableStatusChip name="status-chip" />
        </ui:VisualElement>
        <ui:VisualElement class="apc-body-columns">
            <ui:VisualElement class="apc-body-column">
                <ui:VisualElement class="panel-section" name="power-flow-section">
                    <ui:VisualElement class="panel-section__clip">
                        <ui:Label class="panel-section__header font-titling" text="Power Flow" />
                        <ui:VisualElement class="panel-section__content">
                            <ss3d:PowerFlowRow name="power-flow" grid-input-kw="0" load-output-kw="0" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="panel-section" name="battery-section">
                    <ui:VisualElement class="panel-section__clip">
                        <ui:VisualElement class="panel-section__header panel-section__header--split">
                            <ui:Label class="panel-section__header-title font-titling" text="Battery" />
                            <ui:Label name="battery-state-header" text="CHARGED" class="apc-battery-state-header font-terminal" />
                        </ui:VisualElement>
                        <ui:VisualElement class="panel-section__content">
                            <ss3d:BatteryBar name="battery-bar" value="1" state-text="CHARGED" eta-text="" class="battery-bar--compact" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="panel-section" name="diagnostics-section">
                    <ui:VisualElement class="panel-section__clip">
                        <ui:Label class="panel-section__header font-titling" text="Diagnostics" />
                        <ui:VisualElement class="panel-section__content">
                            <ss3d:DiagnosticsList name="diagnostics-list" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="apc-body-column apc-body-column--controls">
                <ss3d:AccessGatedRegion name="access-region" class="apc-access-region">
                    <ss3d:AccessGatePanel name="access-gate"
                        locked-subline="Insert ID card to control connected systems" />
                    <ui:VisualElement name="access-controls"
                        class="access-gated-region__controls access-gated-region__controls--hidden">
                        <ss3d:AccessStrip name="access-strip" authorized-text="Engineering — Authorized" />
                        <ui:VisualElement class="panel-section" name="channels-section">
                            <ui:VisualElement class="panel-section__clip">
                                <ui:Label class="panel-section__header font-titling" text="Connected Systems" />
                                <ui:VisualElement class="panel-section__content">
                                    <ss3d:ChannelRow name="channel-lighting" channel-name="Lighting" load-kw="0" is-on="true" />
                                    <ss3d:ChannelRow name="channel-equipment" channel-name="Equipment" load-kw="0" is-on="true" />
                                    <ss3d:ChannelRow name="channel-environment" channel-name="Environment" load-kw="0" is-on="true" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label name="shed-hint"
                            text="Turning a system off here immediately reduces load — safe to disable Equipment or Environment during a shortage; Lighting is cheapest to keep on."
                            class="font-body apc-shed-hint" />
                    </ui:VisualElement>
                </ss3d:AccessGatedRegion>
            </ui:VisualElement>
        </ui:VisualElement>
        <ss3d:DeviceFooter name="footer" text="SS3D Area Power Controller — Model APC-7" />
    </ss3d:DiegeticDeviceShell>
</ui:UXML>
