
.apc-identity-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
}

.apc-identity-row .device-identity-block {
    flex-grow: 1;
    margin-right: 16px;
}

.apc-body-columns {
    flex-direction: row;
    align-items: stretch;
}

.apc-body-column {
    flex-direction: column;
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
}

.apc-body-column--controls {
    margin-left: 14px;
}

.apc-access-locked {
    flex-grow: 1;
    background-color: var(--ss3d-diegetic-panel-body);
    border-radius: var(--ss3d-radius-md);
    margin-bottom: 0;
}

.apc-access-unlocked {
    flex-direction: column;
    flex-grow: 1;
    display: none;
}

.apc-access-unlocked .panel-section__content {
    padding-top: 0;
    padding-bottom: 0;
}

.apc-battery-state-header {
    position: absolute;
    right: 14px;
    top: 8px;
    font-size: 12px;
    color: var(--ss3d-text-tertiary);
}

#battery-section {
    position: relative;
}

.apc-shed-hint {
    font-size: 11px;
    color: var(--ss3d-text-tertiary);
    white-space: normal;
    line-height: 1.4;
    margin-top: 4px;
}

.apc-body-column .panel-section {
    margin-bottom: 14px;
}

.apc-body-column .power-flow-row {
    margin-bottom: 0;
    border-width: 0;
    background-color: transparent;
    padding: 0;
}
