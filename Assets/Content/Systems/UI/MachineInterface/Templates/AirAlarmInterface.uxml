<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:ss3d="SS3D.UI.MachineInterface.Components" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/Content/Systems/UI/Tokens/ss3d-tokens.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/Tokens/ss3d-typography.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Tokens/diegetic-tokens.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Tokens/diegetic-tones.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/DiegeticDeviceShell.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/StatusDot.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/ConnectionStatusRow.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/DeviceIdentityBlock.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/GlanceableStatusChip.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/PanelSection.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/ReadoutMetricTile.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/GasBarRow.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/AtmosIdReaderRow.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/PresetModeButton.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/ConnectedDeviceRow.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/AirAlarmDeviceDetailPanel.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/ToggleSwitch.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/CompactFilterToggle.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/NumericStepper.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/SteelButton.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/StatusBadge.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Components/DeviceFooter.uss" />
    <ui:Style src="project://database/Assets/Content/Systems/UI/MachineInterface/Templates/AirAlarmInterface.uss" />

    <ss3d:DiegeticDeviceShell name="device-shell"
        class="diegetic-device-shell--air-alarm"
        model-label="AA-07 · atmospheric alarm control unit"
        power-ok="true"
        style="align-self: center; margin-top: 24px;">
        <ss3d:ConnectionStatusRow name="connection-row"
            status-text="WIRED · ATMOS NET · ZONE ENGINEERING BAY 3"
            readout-text="4 devices linked" />
        <ss3d:DeviceIdentityBlock name="identity"
            title="AA-07"
            subtitle="Engineering Bay 3 — Air Alarm" />
        <ss3d:GlanceableStatusChip name="status-chip" />

        <ui:VisualElement class="panel-section" name="room-readouts-section">
            <ui:VisualElement class="panel-section__clip">
                <ui:VisualElement class="panel-section__header">
                    <ui:Label class="panel-section__header-title font-titling" text="Room Readouts" />
                </ui:VisualElement>
                <ui:VisualElement class="panel-section__content">
                    <ui:VisualElement class="air-alarm-metrics-row">
                        <ss3d:ReadoutMetricTile name="pressure-tile" label="Pressure" value="101.3 kPa" />
                        <ss3d:ReadoutMetricTile name="temperature-tile" label="Temperature" value="20.9°C" />
                    </ui:VisualElement>
                    <ui:Label text="GAS COMPOSITION" class="air-alarm-gas-section-title font-titling" />
                    <ui:VisualElement name="gas-list" class="air-alarm-gas-list" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="panel-section" name="id-reader-section">
            <ui:VisualElement class="panel-section__clip">
                <ui:VisualElement class="panel-section__header">
                    <ui:Label class="panel-section__header-title font-titling" text="ID Reader" />
                </ui:VisualElement>
                <ui:VisualElement class="panel-section__content">
                    <ss3d:AtmosIdReaderRow name="id-reader" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="panel-section" name="preset-modes-section">
            <ui:VisualElement class="panel-section__clip">
                <ui:VisualElement class="panel-section__header air-alarm-mode-header">
                    <ui:Label class="panel-section__header-title font-titling" text="Preset Modes" />
                    <ui:Label name="mode-locked-hint" class="air-alarm-mode-locked-hint font-terminal" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="panel-section__content">
                    <ui:VisualElement class="air-alarm-mode-grid">
                        <ss3d:PresetModeButton name="mode-filtering" title="Filtering" description="Normal operation" active="true" accent="Rust" />
                        <ss3d:PresetModeButton name="mode-panic" title="Panic Siphon" description="Purge all gases" accent="Danger" />
                        <ss3d:PresetModeButton name="mode-fill" title="Repressurize" description="Vents run full" accent="Info" />
                        <ss3d:PresetModeButton name="mode-off" title="Off / None" description="Disable control" accent="Steel" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="panel-section" name="connected-devices-section">
            <ui:VisualElement class="panel-section__clip">
                <ui:VisualElement class="panel-section__header">
                    <ui:Label class="panel-section__header-title font-titling" text="Connected Devices" />
                </ui:VisualElement>
                <ui:VisualElement class="panel-section__content">
                    <ui:VisualElement name="device-list" class="air-alarm-device-list" />
                    <ss3d:AirAlarmDeviceDetailPanel name="device-detail" style="display: none;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ss3d:DeviceFooter name="footer" text="SS3D Atmospherics — Air Alarm Unit Model AA-07" />
    </ss3d:DiegeticDeviceShell>
</ui:UXML>
