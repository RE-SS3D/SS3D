@import url("../Tokens/ss3d-tokens.uss");

.smes-unit-interface {
    flex-direction: column;
    width: 100%;
}

.smes-section-title {
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--ss3d-text-secondary);
    margin-bottom: 6px;
}

.smes-metrics-row {
    flex-direction: row;
    align-items: stretch;
    margin-top: 14px;
}

.smes-storage-column {
    width: 220px;
    flex-shrink: 0;
    margin-right: 14px;
    flex-direction: column;
}

.smes-power-flow-column {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
    justify-content: flex-end;
}

.smes-storage-footer {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 6px;
    font-size: 13px;
}

.smes-charge-trend {
    color: var(--ss3d-text-tertiary);
}

.smes-controls-row {
    flex-direction: row;
    margin-top: 14px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: var(--ss3d-border-subtle);
}

.smes-controls-row .rate-control {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    border-top-width: 0;
    padding-top: 0;
}

#input-control {
    margin-right: 14px;
}

.smes-controls-row .toggle-pill__button {
    min-width: 90px;
}

.smes-unit-interface .storage-cell-row__cell {
    height: 26px;
}

.smes-unit-interface .warning-panel {
    margin-top: 14px;
}

.tone-success {
    color: var(--ss3d-feedback-success);
}

.tone-warning {
    color: var(--ss3d-feedback-warning);
}

.tone-danger {
    color: var(--ss3d-feedback-danger);
}

.tone-info {
    color: var(--ss3d-text-tertiary);
}
