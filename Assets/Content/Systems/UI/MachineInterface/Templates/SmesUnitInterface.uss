
.smes-access-region {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    background-color: var(--ss3d-diegetic-panel-body);
    border-radius: var(--ss3d-radius-md);
    margin-bottom: 14px;
}

.smes-section-title {
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--ss3d-text-secondary);
    margin-bottom: 6px;
}

.smes-metrics-row {
    flex-direction: row;
    align-items: stretch;
}

.smes-storage-column {
    width: 220px;
    flex-shrink: 0;
    margin-right: 14px;
    flex-direction: column;
}

.smes-power-flow-column {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
    justify-content: flex-end;
}

.smes-storage-footer {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 6px;
    font-size: 13px;
}

.smes-charge-trend {
    color: var(--ss3d-text-tertiary);
}

.smes-controls-row {
    flex-direction: row;
}

.smes-controls-row .rate-control {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    border-top-width: 0;
    padding-top: 0;
}

#input-control {
    margin-right: 14px;
}

.smes-unit-interface .storage-cell-row__cell {
    height: 26px;
}

#storage-flow-section .panel-section__content {
    padding-top: 14px;
}

#controls-section .rate-control {
    border-top-width: 0;
    padding-top: 0;
}

.tone-success {
    color: var(--ss3d-feedback-success);
}

.tone-warning {
    color: var(--ss3d-feedback-warning);
}

.tone-danger {
    color: var(--ss3d-feedback-danger);
}

.tone-info {
    color: var(--ss3d-text-tertiary);
}
