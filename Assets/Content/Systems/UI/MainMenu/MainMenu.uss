@import url("../Tokens/ui-tokens.uss");
@import url("../Tokens/ui-controls.uss");

/*
 * Main menu, drawn with the UI bible's parts (Documents/plans/assets/ui-bible, "main menu" tab; its components.css
 * main-menu section is this sheet's base, in USS):
 *   plates        --ui-editor-panel with the storage panel's 2 px edge and corner, 16 px from the screen's edges
 *   sidebar       the screen's tab column: light tints, Disket titles, Kode subtitles. The white plate marks where you
 *                 are: Join on the home screen (--accent), the open screen's row (--selected) with the notch
 *   server list   raised tints under headings with an icon and a rule. A server's state is an icon in its colour, and
 *                 its card's left edge takes that colour on hover and while it is open
 *   state areas   a soft fill (--ui-*-soft) and a 3 px left edge: the update news, first launch, a refusal, a failed
 *                 fetch, a failed step. Inset (darker than the plate): fields, the port, empty lists
 *   buttons       primary the white plate; secondary a tint with a faint edge; info and danger their colour's edge,
 *                 filled soft on hover; quiet ones (links, Details) text only
 *   dialogs       a floating plate (--ui-float) over the blurred wallpaper. It eases in, and its colour (--op) says
 *                 what it is doing: hosting ok, joining info, updating warn, lost or failed danger. The icon, the
 *                 progress bar and the working step take it; MainMenuView spins the working step's icon
 *   colour code   Join a server is info and Play locally ok, as their dialogs: the row's left edge and its icon.
 *                 A server's state is an icon in its colour (the Checking one spins)
 *   motion        0.12 s on every hover and press, and a press scales the plate down a little. Entrances are UiMotion's
 *                 (Tokens/ui-controls.uss), run by MainMenuView: the sidebar's rows when it shows, a panel from the
 *                 right, the list's rows and the dialog's steps one after another. One ambient loop: the wallpaper
 *                 drifts on the home screen
 * Sizes are the bible's reference px: MainMenuView lays .main-menu out at 1200 × 675 and scales it to fill the
 * screen (UiReferenceScale), times the player's UI scale.
 * Labels are Disket Mono Bold, which draws only capitals; text is Kode Mono.
 * Buttons keep the runtime theme's .unity-button class, so every Button class here sets its own background, border and
 * colour for :hover and :active too, or the theme's light grey shows through.
 */

.main-menu {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    background-color: rgb(0, 0, 0);
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/KodeMonoSDF.asset");
    /* The baked fonts are static font assets, which only the standard generator draws (editor panels default to the
       advanced one, so the preview window would show no text). */
    -unity-text-generator: standard;
    font-size: 12px;
    color: var(--ui-text);
}

.main-menu .unity-disabled {
    opacity: 1;
}

.main-menu .main-menu__text {
    margin: 0;
    padding: 0;
}

.main-menu .main-menu__hidden {
    display: none;
}

/* The wallpaper rotates every 60 s while browsing: a still or one of Bug's looping clips, picked at random, with a dip
   to black between them (MainMenuWallpaperRotation).
   The one ambient loop: on the home screen MainMenuView toggles --drift every 18 s and a still eases between the two
   looks over as long, so it never rests. Scaled up a little, so the drift never shows an edge. Behind a dialog it
   settles and holds still (--still). */
.main-menu__wallpaper {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    scale: 1.04 1.04;
    translate: -8px -4px;
    transition-property: scale, translate;
    transition-duration: 18s;
    transition-timing-function: ease-in-out-sine;
}

.main-menu__wallpaper--drift {
    scale: 1.08 1.08;
    translate: 8px 4px;
}

.main-menu__wallpaper--still {
    scale: 1.04 1.04;
    translate: 0 0;
    transition-duration: 0.6s;
    transition-timing-function: ease-out-cubic;
}

/* A video wallpaper's frames, over the still (its fallback until the first frame, or if it fails). */
.main-menu__video-wallpaper {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.5s;
}

.main-menu__video-wallpaper--visible {
    opacity: 1;
}

/* Black over the wallpaper while it changes; the fade matches MainMenuWallpaperRotation.FadeSeconds. */
.main-menu__wallpaper-veil {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.5s;
}

.main-menu__wallpaper-veil--on {
    opacity: 1;
}

/* ── Thin scrollers: the map editor's ── */
.main-menu .unity-scroller--vertical {
    width: 6px;
    min-width: 6px;
    margin-left: 2px;
}

.main-menu .unity-scroller--vertical .unity-scroller__low-button,
.main-menu .unity-scroller--vertical .unity-scroller__high-button {
    display: none;
}

.main-menu .unity-scroller--vertical .unity-scroller__slider {
    width: 6px;
    min-width: 6px;
    margin: 0;
}

.main-menu .unity-scroller--vertical .unity-base-slider__tracker {
    width: 6px;
    left: 0;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0);
}

.main-menu .unity-scroller--vertical .unity-base-slider__dragger {
    width: 6px;
    left: 0;
    margin-left: 0;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.22);
    transition-property: background-color;
    transition-duration: 0.12s;
}

.main-menu .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: rgba(255, 255, 255, 0.4);
}

.main-menu .unity-scroller--vertical .unity-base-slider__dragger-border {
    display: none;
}

/* ── Plates ── */
.main-menu__sidebar,
.main-menu__panel {
    position: absolute;
    top: 16px;
    bottom: 16px;
    background-color: var(--ui-editor-panel);
    border-width: var(--ui-hairline);
    border-color: var(--ui-panel-edge);
    border-radius: var(--ui-panel-radius);
}

/* The ScrollView sits inside the rounded plate, not on it: a radius and overflow: hidden on one element draw white. */
.main-menu__sidebar {
    left: 16px;
    width: 344px;
}

.main-menu__sidebar-scroll {
    flex-grow: 1;
}

.main-menu__sidebar-scroll .unity-scroll-view__content-container {
    padding: 0 20px;
}

.main-menu__panel {
    left: 376px;
    right: 16px;
    max-width: 960px;
}

/* ── Sidebar ── */
.main-menu__logo {
    width: 270px;
    height: 126.5px; /* the logo's 1920 × 900 */
    margin: 18px 0 2px 0;
    flex-shrink: 0;
    align-self: center;
    -unity-background-scale-mode: scale-to-fit;
}

.main-menu .main-menu__eyebrow {
    margin-bottom: 6px;
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 10px;
    color: rgba(255, 255, 255, 0.5);
    white-space: nowrap;
}

.main-menu__identity {
    margin-top: 16px;
    flex-shrink: 0;
}

/* The menu's text field on an editor plate: inset, near-black, as the editor's search. Its edge shows on hover and
   brightens with focus. */
.main-menu .main-menu__input {
    height: 32px;
    min-width: 0;
    margin: 0;
    padding: 0;
}

.main-menu .main-menu__input > .unity-base-text-field__input {
    margin: 0;
    padding: 0 10px;
    border-width: 1px;
    border-radius: 0;
    border-color: rgba(0, 0, 0, 0);
    background-color: var(--ui-editor-search);
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/KodeMonoSDF.asset");
    font-size: 13px;
    color: var(--ui-text);
    -unity-text-align: middle-left;
    --unity-cursor-color: rgb(242, 242, 240);
    --unity-selection-color: rgba(255, 255, 255, 0.25);
    transition-property: border-color;
    transition-duration: 0.12s;
}

.main-menu .main-menu__input:hover > .unity-base-text-field__input {
    border-color: rgba(255, 255, 255, 0.16);
}

.main-menu .main-menu__input:focus > .unity-base-text-field__input,
.main-menu .main-menu__input > .unity-base-text-field__input:focus {
    border-color: var(--ui-editor-cell-edge-hover);
}

.main-menu .main-menu__input .unity-base-text-field__input--placeholder {
    color: var(--ui-text-faint);
}

.main-menu .main-menu__hint {
    margin-top: 6px;
    font-size: 10.5px;
    color: rgba(255, 255, 255, 0.5);
    white-space: normal;
}

.main-menu .main-menu__hint--warning {
    color: var(--ui-warn);
}

.main-menu .main-menu__hint--error {
    color: rgb(244, 156, 146);
}

.main-menu__navigation {
    margin-top: 18px;
    flex-shrink: 0;
}

/* A row is a tab: a light tint, the label in Disket, a line of Kode under it. A press sinks it a little. */
.main-menu .main-menu__nav {
    flex-direction: row;
    height: 52px;
    margin: 0 0 4px 0;
    padding: 0 14px 0 11px;
    justify-content: flex-start;
    align-items: center;
    border-width: 0 0 0 3px;
    border-radius: 0;
    border-color: rgba(0, 0, 0, 0);
    background-color: var(--ui-editor-button);
    transition-property: background-color, border-color, scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out-cubic;
}

.main-menu .main-menu__nav:hover {
    background-color: var(--ui-editor-button-hover);
}

.main-menu .main-menu__nav:active,
.main-menu .main-menu__nav:hover:active {
    background-color: var(--ui-editor-button-pressed);
    scale: 0.98 0.98;
}

/* Settings and Quit: a title alone, so a shorter row. */
.main-menu .main-menu__nav--short {
    height: 40px;
}

.main-menu .main-menu__title {
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 15px;
    color: var(--ui-text);
    white-space: nowrap;
    transition-property: color;
    transition-duration: 0.12s;
}

.main-menu .main-menu__nav-subtitle {
    margin-top: 6px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.5);
    white-space: nowrap;
    transition-property: color;
    transition-duration: 0.12s;
}

.main-menu .main-menu__nav-subtitle--error {
    color: rgb(244, 156, 146);
}

/* Where you are: the white plate of a selected menu tab; the open screen's row adds the notch aimed at its panel. */
.main-menu .main-menu__nav.main-menu__button--accent,
.main-menu .main-menu__nav.main-menu__nav--selected {
    background-color: var(--ui-menu-selected);
}

.main-menu .main-menu__nav.main-menu__button--accent:hover,
.main-menu .main-menu__nav.main-menu__nav--selected:hover {
    background-color: rgb(255, 255, 255);
}

.main-menu .main-menu__nav.main-menu__button--accent:active,
.main-menu .main-menu__nav.main-menu__button--accent:hover:active,
.main-menu .main-menu__nav.main-menu__nav--selected:active,
.main-menu .main-menu__nav.main-menu__nav--selected:hover:active {
    background-color: rgb(207, 207, 204);
}

.main-menu .main-menu__button--accent .main-menu__title,
.main-menu .main-menu__nav--selected .main-menu__title {
    color: var(--ui-text-on-light);
}

.main-menu .main-menu__button--accent .main-menu__nav-subtitle,
.main-menu .main-menu__nav--selected .main-menu__nav-subtitle {
    color: rgba(13, 13, 13, 0.6);
}

/* The notch slides out of the plate as its screen opens. */
.main-menu__nav-tip {
    position: absolute;
    right: -6px;
    top: 50%;
    width: 12px;
    height: 12px;
    margin-top: -6px;
    rotate: 45deg;
    background-color: var(--ui-menu-selected);
    opacity: 0;
    translate: -6px 0;
    transition-property: opacity, translate, background-color;
    transition-duration: 0.2s, 0.2s, 0.12s;
    transition-timing-function: ease-out-cubic;
}

.main-menu .main-menu__nav--selected > .main-menu__nav-tip {
    opacity: 1;
    translate: 0 0;
}

.main-menu .main-menu__nav--selected:active > .main-menu__nav-tip {
    background-color: rgb(207, 207, 204);
}

/* Disabled (no name yet): the plate fades and so does its text. */
.main-menu .main-menu__nav:disabled,
.main-menu .main-menu__nav.main-menu__button--accent:disabled {
    background-color: rgba(255, 255, 255, 0.03);
}

.main-menu .main-menu__nav:disabled .main-menu__title,
.main-menu .main-menu__nav:disabled .main-menu__nav-subtitle {
    color: var(--ui-menu-tab-text);
}

.main-menu__local-row {
    flex-direction: row;
    margin-bottom: 4px;
}

.main-menu .main-menu__local-row > .main-menu__nav {
    flex-grow: 1;
    margin-bottom: 0;
}

/* The port, tucked away: a square at the end of the row, "Port" over the number. Lit, with Play locally's ok edge,
   while its field is open. */
.main-menu .main-menu__advanced {
    width: 52px;
    height: 52px;
    margin: 0 0 0 2px;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: 0 0 2px 0;
    border-radius: 0;
    border-color: rgba(0, 0, 0, 0);
    background-color: var(--ui-editor-button);
    transition-property: background-color, border-color, scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out-cubic;
}

.main-menu .main-menu__advanced:hover {
    background-color: var(--ui-editor-button-hover);
}

.main-menu .main-menu__advanced--open,
.main-menu .main-menu__advanced--open:hover {
    background-color: var(--ui-editor-button-hover);
    border-color: var(--ui-ok);
}

.main-menu .main-menu__advanced:active,
.main-menu .main-menu__advanced:hover:active {
    background-color: var(--ui-editor-button-pressed);
    scale: 0.94 0.94;
}

.main-menu .main-menu__advanced-label {
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 9px;
    color: rgba(255, 255, 255, 0.55);
    transition-property: color;
    transition-duration: 0.12s;
}

.main-menu .main-menu__advanced:hover .main-menu__advanced-label {
    color: rgba(255, 255, 255, 0.9);
}

.main-menu .main-menu__advanced-port {
    margin-top: 4px;
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 11px;
    color: rgba(255, 255, 255, 0.8);
    transition-property: color;
    transition-duration: 0.12s;
}

.main-menu .main-menu__advanced:hover .main-menu__advanced-port,
.main-menu .main-menu__advanced--open .main-menu__advanced-port {
    color: var(--ui-text);
}

/* The port: inset under Play locally, with its ok edge, so it reads as that row's setting. */
.main-menu__port {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
    padding: 8px 14px 8px 11px;
    border-left-width: 3px;
    border-color: var(--ui-ok);
    background-color: rgba(0, 0, 0, 0.32);
}

.main-menu .main-menu__port > .main-menu__eyebrow {
    margin-bottom: 0;
}

.main-menu .main-menu__port-input {
    width: 76px;
    height: 28px;
    margin: 0 10px;
    flex-shrink: 0;
}

.main-menu .main-menu__port > .main-menu__hint {
    margin-top: 0;
    flex-shrink: 1;
}

.main-menu__spacer {
    flex-grow: 1;
    min-height: 12px;
}

/* ── Music: two cells and a slider ── */
.main-menu__music {
    flex-direction: row;
    align-items: center;
    padding: 10px 0;
    flex-shrink: 0;
}

.main-menu .main-menu__music-toggle,
.main-menu .main-menu__music-next {
    width: 28px;
    height: 28px;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-width: var(--ui-hairline);
    border-color: var(--ui-editor-cell-edge);
    border-radius: 4.2px; /* 15 % */
    background-color: rgba(0, 0, 0, 0);
    transition-property: border-color, background-color, scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out-cubic;
}

.main-menu .main-menu__music-toggle:hover,
.main-menu .main-menu__music-next:hover {
    border-color: var(--ui-editor-cell-edge-hover);
    background-color: rgba(255, 255, 255, 0.06);
}

.main-menu .main-menu__music-toggle:active,
.main-menu .main-menu__music-next:active,
.main-menu .main-menu__music-toggle:hover:active,
.main-menu .main-menu__music-next:hover:active {
    border-color: var(--ui-editor-cell-edge-hover);
    background-color: rgba(255, 255, 255, 0.1);
    scale: 0.9 0.9;
}

.main-menu .main-menu__music-next:disabled,
.main-menu .main-menu__music-next:disabled:hover {
    border-color: var(--ui-editor-cell-edge);
    background-color: rgba(0, 0, 0, 0);
}

.main-menu .main-menu__music-toggle--on,
.main-menu .main-menu__music-toggle--on:hover {
    border-color: var(--ui-line-active);
}

.main-menu__music-icon {
    width: 14px;
    height: 14px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.48);
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.12s;
}

.main-menu__music-icon--next {
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Solid/FastForward.png");
}

.main-menu .main-menu__music-toggle--on .main-menu__music-icon,
.main-menu .main-menu__music-next .main-menu__music-icon,
.main-menu .main-menu__music-toggle:hover .main-menu__music-icon {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.main-menu .main-menu__music-next:disabled .main-menu__music-icon {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.16);
}

.main-menu__music-text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 10px;
}

.main-menu .main-menu__music-eyebrow {
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 9px;
    color: rgba(255, 255, 255, 0.45);
}

.main-menu .main-menu__music-title {
    margin-top: 4px;
    font-size: 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.main-menu .main-menu__music--off .main-menu__music-title {
    color: rgba(255, 255, 255, 0.45);
}

/* The menu slider: a dark track, a light line for the level, a small plate for the dragger. */
.main-menu #music-volume {
    width: 72px;
    height: 16px;
    min-height: 16px;
    margin: 0 0 0 10px;
    padding: 0;
    flex-shrink: 0;
    align-self: center;
}

.main-menu #music-volume > .unity-base-slider__input {
    height: 16px;
    min-height: 16px;
    margin: 0;
    padding: 0;
}

.main-menu #music-volume .unity-base-slider__drag-container {
    height: 16px;
    margin: 0;
    padding: 0;
}

.main-menu #music-volume .unity-base-slider__tracker {
    top: 4px;
    height: 8px;
    margin: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0.45);
}

.main-menu #music-volume .unity-base-slider__dragger {
    position: absolute;
    top: 1px;
    width: 27px;
    height: 14px;
    margin: 0;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.24);
    border-radius: 3px;
    background-color: rgba(42, 38, 40, 0.96);
    transition-property: border-color;
    transition-duration: 0.12s;
}

.main-menu #music-volume:hover .unity-base-slider__dragger {
    border-color: rgba(255, 255, 255, 0.7);
}

.main-menu #music-volume .unity-base-slider__dragger-border {
    display: none;
}

.main-menu .main-menu__music-volume-fill {
    position: absolute;
    left: 0;
    top: 3px;
    height: 2px;
    background-color: rgba(255, 255, 255, 0.36);
}

.main-menu .main-menu__music--off #music-volume {
    opacity: 0.4;
}

/* ── Footer ── */
.main-menu__footer {
    padding: 4px 0 14px 0;
    flex-shrink: 0;
}

.main-menu__row {
    flex-direction: row;
    align-items: center;
}

.main-menu__spread {
    justify-content: space-between;
}

.main-menu__end {
    justify-content: flex-end;
}

.main-menu__footer > .main-menu__row {
    margin-top: 6px;
}

.main-menu .main-menu__fine {
    font-size: 10.5px;
    color: rgba(255, 255, 255, 0.5);
    white-space: nowrap;
}

/* A link: quiet, underlined, brightening on hover. */
.main-menu .main-menu__link,
.main-menu .main-menu__link:hover,
.main-menu .main-menu__link:active,
.main-menu .main-menu__link:hover:active {
    background-color: rgba(0, 0, 0, 0);
}

.main-menu .main-menu__link {
    margin: 0 0 0 4px;
    padding: 0 0 1px 0;
    border-width: 0 0 1px 0;
    border-radius: 0;
    border-color: rgba(255, 255, 255, 0.3);
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/KodeMonoSDF.asset");
    font-size: 10.5px;
    color: rgba(255, 255, 255, 0.75);
    white-space: nowrap;
    -unity-text-align: middle-left;
    transition-property: color, border-color;
    transition-duration: 0.12s;
}

.main-menu .main-menu__link:hover {
    border-color: var(--ui-text);
    color: var(--ui-text);
}

.main-menu .main-menu__link:hover:active {
    border-color: rgba(255, 255, 255, 0.5);
    color: rgba(255, 255, 255, 0.6);
}

/* ── Update banner: news, so the info colour as an area: a soft fill, its left edge and the dot ── */
.main-menu__update {
    margin-top: 12px;
    padding: 12px 12px 12px 9px;
    flex-shrink: 0;
    border-left-width: 3px;
    border-color: var(--ui-info);
    background-color: var(--ui-info-soft);
}

.main-menu .main-menu__update-title {
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 12px;
}

.main-menu .main-menu__banner-copy {
    margin: 8px 0 10px 0;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.7);
    white-space: normal;
}

.main-menu .main-menu__beside {
    margin: 0 0 0 10px;
    flex-shrink: 1;
}

.main-menu__dot {
    width: 8px;
    height: 8px;
    margin-right: 10px;
    flex-shrink: 0;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.3);
}

.main-menu__dot--ok {
    background-color: var(--ui-ok);
}

.main-menu__dot--warn {
    background-color: var(--ui-warn);
}

.main-menu__dot--danger {
    background-color: var(--ui-danger);
}

.main-menu__dot--info {
    background-color: var(--ui-info);
}

/* ── Buttons: a Disket label. The primary is the white plate; a secondary a light tint with a faint edge; info and
   danger carry their colour's edge and fill soft with it on hover. A press sinks every one a little ── */
.main-menu .main-menu__button {
    flex-direction: row;
    height: 32px;
    margin: 0;
    padding: 0 14px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-width: var(--ui-hairline);
    border-radius: 0;
    border-color: rgba(255, 255, 255, 0.08);
    background-color: var(--ui-editor-button);
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 12px;
    color: var(--ui-text);
    white-space: nowrap;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color, color, scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out-cubic;
}

.main-menu .main-menu__button:hover {
    background-color: var(--ui-editor-button-hover);
    border-color: rgba(255, 255, 255, 0.24);
}

.main-menu .main-menu__button:active,
.main-menu .main-menu__button:hover:active {
    background-color: var(--ui-editor-button-pressed);
    scale: 0.97 0.97;
}

.main-menu .main-menu__button.main-menu__button--accent {
    border-color: rgba(0, 0, 0, 0);
    background-color: var(--ui-menu-selected);
    color: var(--ui-text-on-light);
}

/* The white plate can't get whiter: its hover is a faint info wash (joining, connecting). */
.main-menu .main-menu__button.main-menu__button--accent:hover {
    border-color: rgba(0, 0, 0, 0);
    background-color: rgb(234, 245, 255);
}

.main-menu .main-menu__button.main-menu__button--accent:active,
.main-menu .main-menu__button.main-menu__button--accent:hover:active {
    background-color: rgb(207, 207, 204);
}

/* Update a server: the info colour, as the banner. */
.main-menu .main-menu__button--blue,
.main-menu .main-menu__button--blue:hover,
.main-menu .main-menu__button--blue:active,
.main-menu .main-menu__button--blue:hover:active {
    border-color: var(--ui-info);
}

.main-menu .main-menu__button--blue:hover,
.main-menu .main-menu__button--blue:hover:active {
    background-color: var(--ui-info-soft);
    color: var(--ui-info);
}

.main-menu .main-menu__button--danger,
.main-menu .main-menu__button--danger:hover,
.main-menu .main-menu__button--danger:active,
.main-menu .main-menu__button--danger:hover:active {
    border-color: var(--ui-danger);
}

.main-menu .main-menu__button--danger:hover,
.main-menu .main-menu__button--danger:hover:active {
    background-color: var(--ui-danger-soft);
    color: var(--ui-danger);
}

.main-menu .main-menu__button:disabled,
.main-menu .main-menu__button.main-menu__button--accent:disabled {
    background-color: rgba(255, 255, 255, 0.03);
    border-color: rgba(0, 0, 0, 0);
    color: var(--ui-menu-tab-text);
}

/* A cell with a glyph (refresh, close): the map editor's popover close. Close turns a quarter on hover; refresh spins
   in the info colour while a server is being asked. */
.main-menu .main-menu__icon-btn,
.main-menu .main-menu__icon-btn:active,
.main-menu .main-menu__icon-btn:hover:active {
    background-color: rgba(0, 0, 0, 0);
}

.main-menu .main-menu__icon-btn {
    width: 28px;
    height: 28px;
    margin: 0 0 0 6px;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: var(--ui-hairline);
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4.2px; /* 15 % */
    transition-property: border-color, scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out-cubic;
}

.main-menu .main-menu__icon-btn:hover {
    border-color: var(--ui-editor-cell-edge);
    background-color: rgba(0, 0, 0, 0);
}

.main-menu .main-menu__icon-btn:active,
.main-menu .main-menu__icon-btn:hover:active {
    border-color: var(--ui-editor-cell-edge-hover);
    scale: 0.9 0.9;
}

.main-menu__icon-btn__icon {
    width: 14px;
    height: 14px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.6);
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.12s;
}

.main-menu .main-menu__icon-btn:hover .main-menu__icon-btn__icon {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

/* No rotate transition: MainMenuView spins this one by hand, every frame. */
.main-menu__icon-btn__icon--refresh {
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Solid/Refresh.png");
}

.main-menu .main-menu__icon-btn__icon--refresh.main-menu__spin {
    -unity-background-image-tint-color: var(--ui-info);
}

.main-menu__icon-btn__icon--close {
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Solid/X.png");
    transition-property: -unity-background-image-tint-color, rotate;
    transition-duration: 0.12s, 0.25s;
    transition-timing-function: linear, ease-out-cubic;
}

.main-menu .main-menu__icon-btn:hover .main-menu__icon-btn__icon--close {
    rotate: 90deg;
}

/* A key name: the map editor's chip. */
.main-menu .main-menu__key {
    height: 16px;
    margin-left: 10px;
    padding: 0 4px;
    justify-content: center;
    border-radius: 2.4px;
    background-color: rgba(0, 0, 0, 0.45);
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 9px;
    color: rgba(255, 255, 255, 0.7);
    -unity-text-align: middle-center;
}

/* ── The panel: servers or settings ── */
.main-menu__header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 56px;
    padding: 0 12px 0 20px;
}

.main-menu .main-menu__header > .main-menu__title {
    font-size: 20px;
}

.main-menu .main-menu__header > .main-menu__fine {
    margin-right: 4px;
}

.main-menu__header-spacer {
    flex-grow: 1;
}

/* The server panel is Join a server's screen: its icon, in its colour. */
.main-menu__panel-icon {
    width: 20px;
    height: 20px;
    margin-right: 12px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Outline/GlobeAlt.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--ui-info);
}

.main-menu__server-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.main-menu__server-content {
    padding: 4px 20px 20px 20px;
}

.main-menu__section {
    margin-bottom: 22px;
    flex-shrink: 0;
}

/* A section's heading: an icon in the join colour, the title, a hairline out to the count. */
.main-menu__section-heading {
    align-items: center;
    margin-bottom: 8px;
}

.main-menu .main-menu__section-heading > .main-menu__eyebrow {
    margin-bottom: 0;
    color: rgba(255, 255, 255, 0.72);
}

.main-menu__heading-icon {
    width: 14px;
    height: 14px;
    margin-right: 8px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--ui-info);
}

.main-menu__heading-icon--direct {
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Outline/Link.png");
}

.main-menu__heading-icon--recent {
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Outline/Clock.png");
}

.main-menu__heading-icon--public {
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Outline/GlobeAlt.png");
}

.main-menu__heading-rule {
    flex-grow: 1;
    height: 1px;
    margin: 0 0 0 10px;
    background-color: rgba(255, 255, 255, 0.08);
}

.main-menu .main-menu__section-heading > .main-menu__fine {
    margin-left: 10px;
}

.main-menu__direct-row {
    flex-direction: row;
    align-items: center;
}

.main-menu .main-menu__address {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 6px;
}

/* First launch: the field explained, as an info area (a soft fill and its edge). */
.main-menu__first {
    padding: 16px 16px 16px 13px;
    border-left-width: 3px;
    border-color: var(--ui-info);
    background-color: var(--ui-info-soft);
}

.main-menu .main-menu__first > .main-menu__section-heading {
    margin-bottom: 0;
}

.main-menu .main-menu__first-title {
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 14px;
}

.main-menu .main-menu__first-copy {
    margin: 8px 0 12px 0;
    font-size: 11.5px;
    color: rgba(255, 255, 255, 0.6);
    white-space: normal;
}

.main-menu .main-menu__first > .main-menu__link {
    align-self: flex-start;
    margin: 12px 0 0 0;
}

.main-menu__server-heading {
    flex-direction: row;
    padding: 0 10px 0 38px;
    margin-bottom: 6px;
}

/* Column heads reuse the columns' classes for their widths; the type is the heading's. */
.main-menu .main-menu__server-heading > .main-menu__text {
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 9px;
    color: rgba(255, 255, 255, 0.4);
}

/* A server: a raised tint. Its left edge takes the state's colour (--state) on hover and keeps it while the card is
   open; a refusal makes it danger. MainMenuView adds main-menu__server--<state>, --open and --refused. */
.main-menu__server {
    --state: rgba(255, 255, 255, 0.5);
    margin-bottom: 4px;
    border-left-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    background-color: var(--ui-editor-button);
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.main-menu__server--online {
    --state: var(--ui-ok);
}

.main-menu__server--update,
.main-menu__server--checking {
    --state: var(--ui-info);
}

.main-menu__server--full,
.main-menu__server--older {
    --state: var(--ui-warn);
}

.main-menu__server--offline {
    --state: var(--ui-danger);
}

.main-menu__server:hover {
    border-color: var(--state);
    background-color: rgba(255, 255, 255, 0.1);
}

.main-menu__server--open {
    border-color: var(--state);
}

.main-menu__server--refused,
.main-menu__server--refused:hover {
    border-color: var(--ui-danger);
}

/* 14 px in from the card's edge, as the column heads: the edge's 3 and these 11. */
.main-menu__server-row {
    flex-direction: row;
    align-items: center;
    height: 52px;
    padding: 0 10px 0 11px;
}

.main-menu .main-menu__server-identity {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 12px;
}

.main-menu .main-menu__server-name {
    font-size: 13px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.main-menu .main-menu__server-address {
    margin-top: 5px;
    font-size: 10.5px;
    color: rgba(255, 255, 255, 0.5);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.main-menu .main-menu__status {
    width: 150px;
    flex-shrink: 0;
    margin-right: 12px;
    font-size: 11.5px;
    color: rgba(255, 255, 255, 0.7);
    white-space: normal;
}

.main-menu .main-menu__status--warn,
.main-menu .main-menu__players--warn {
    color: var(--ui-warn);
}

.main-menu .main-menu__status--danger {
    color: var(--ui-danger);
}

.main-menu .main-menu__players,
.main-menu .main-menu__ping {
    width: 52px;
    flex-shrink: 0;
    margin-right: 12px;
    font-size: 12px;
    -unity-text-align: middle-right;
}

.main-menu .main-menu__ping {
    color: rgba(255, 255, 255, 0.5);
}

.main-menu .main-menu__actions {
    width: 156px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

/* Details / Hide / Show: a quiet text button. */
.main-menu .main-menu__details-button,
.main-menu .main-menu__details-button:hover,
.main-menu .main-menu__details-button:active,
.main-menu .main-menu__details-button:hover:active {
    background-color: rgba(0, 0, 0, 0);
}

.main-menu .main-menu__details-button {
    height: 28px;
    margin: 0 6px 0 0;
    padding: 0 8px;
    justify-content: center;
    border-width: 0;
    border-radius: 0;
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 10px;
    color: rgba(255, 255, 255, 0.55);
    -unity-text-align: middle-center;
    transition-property: color;
    transition-duration: 0.12s;
}

.main-menu .main-menu__details-button:hover {
    color: var(--ui-text);
}

.main-menu .main-menu__details-button:hover:active {
    color: rgba(255, 255, 255, 0.5);
}

/* Refused last time: the reason under the row, on a danger area; the card's edge is danger too. */
.main-menu__refusal {
    flex-direction: row;
    justify-content: space-between;
    padding: 7px 12px 7px 29px;
    background-color: var(--ui-danger-soft);
}

.main-menu .main-menu__refusal > .main-menu__text {
    flex-shrink: 1;
    font-size: 11px;
    color: rgb(244, 156, 146);
    white-space: normal;
}

.main-menu .main-menu__refusal > .main-menu__fine {
    flex-shrink: 0;
    margin-left: 12px;
    color: rgba(255, 255, 255, 0.5);
    white-space: nowrap;
}

.main-menu__details {
    padding: 4px 12px 12px 29px;
}

.main-menu__detail-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.main-menu .main-menu__detail-key {
    width: 116px;
    flex-shrink: 0;
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 10px;
    color: rgba(255, 255, 255, 0.5);
}

.main-menu .main-menu__detail-value {
    width: 300px;
    height: 28px;
    flex-shrink: 1;
}

.main-menu .main-menu__detail-text {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.75);
}

.main-menu__details-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 4px;
}

.main-menu .main-menu__details-footer > .main-menu__hint {
    max-width: 380px;
    flex-shrink: 1;
    margin: 0 12px 0 0;
}

/* Nothing here yet: inset, darker than the plate, with a faint edge. A list that could not be fetched is a warning
   area instead. */
.main-menu__empty {
    padding: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    background-color: rgba(0, 0, 0, 0.28);
}

.main-menu__empty--failed {
    padding: 15px 15px 15px 12px;
    border-width: 0 0 0 3px;
    border-color: var(--ui-warn);
    background-color: var(--ui-warn-soft);
}

.main-menu .main-menu__empty-title {
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 12px;
    color: rgba(255, 255, 255, 0.8);
}

.main-menu .main-menu__empty--failed > .main-menu__empty-title {
    color: var(--ui-warn);
}

.main-menu .main-menu__empty > .main-menu__hint {
    margin-top: 7px;
}

/* ── Dialogs: connecting, starting, updating, lost. A floating plate over the blurred wallpaper ── */
.main-menu__overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.3);
}

.main-menu__dialog {
    width: 440px;
    background-color: var(--ui-float);
    border-width: var(--ui-hairline);
    border-color: var(--ui-panel-edge);
    border-radius: var(--ui-panel-radius);
}

.main-menu .main-menu__dialog > .main-menu__header {
    height: 48px;
    padding: 0 16px;
}

.main-menu .main-menu__dialog > .main-menu__header > .main-menu__title {
    font-size: 16px;
}

.main-menu__dialog-body {
    padding: 0 16px 16px 16px;
}

.main-menu .main-menu__overlay-name {
    font-size: 14px;
}

.main-menu .main-menu__overlay-address {
    margin-top: 5px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.5);
}

.main-menu__steps {
    margin: 14px 0;
}

.main-menu__step {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 30px;
    margin-bottom: 2px;
    padding: 0 10px;
    background-color: var(--ui-editor-button);
}

.main-menu .main-menu__step > .main-menu__text {
    font-size: 12px;
}

.main-menu .main-menu__step--pending > .main-menu__text {
    color: rgba(255, 255, 255, 0.4);
}

.main-menu .main-menu__step > .main-menu__step-mark {
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 10px;
    color: var(--ui-text);
}

.main-menu .main-menu__step > .main-menu__step-mark--ok {
    color: var(--ui-ok);
}

.main-menu .main-menu__step > .main-menu__step-mark--failed {
    color: var(--ui-danger);
}

/* Why it failed: a danger area under the step. */
.main-menu__step-reason {
    margin-bottom: 2px;
    padding: 8px 10px 8px 7px;
    border-left-width: 3px;
    border-color: var(--ui-danger);
    background-color: var(--ui-danger-soft);
}

.main-menu .main-menu__step-reason > .main-menu__text {
    font-size: 11.5px;
    color: rgb(244, 156, 146);
    white-space: normal;
}

.main-menu__token-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

.main-menu .main-menu__token-input {
    flex-grow: 1;
    flex-shrink: 1;
    height: 28px;
}

.main-menu .main-menu__dialog-action {
    margin-left: 6px;
}

/* ══ Sidebar icons and colour ══ */
.main-menu__nav-text {
    flex-grow: 1;
    flex-shrink: 1;
    /* Left-aligned at their own width: a Button's centred text alignment is inherited. */
    align-items: flex-start;
}

/* On hover the icon steps toward the panel; Settings' cog turns, Quit's door goes danger. */
.main-menu__nav-icon {
    width: 18px;
    height: 18px;
    margin-right: 12px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.7);
    transition-property: translate, rotate, -unity-background-image-tint-color;
    transition-duration: 0.14s, 0.45s, 0.14s;
    transition-timing-function: ease-out-cubic;
}

.main-menu .main-menu__nav:hover > .main-menu__nav-icon {
    translate: 3px 0;
}

.main-menu .main-menu__nav--join {
    --nav: var(--ui-info);
    border-color: var(--ui-info);
}

.main-menu .main-menu__nav--local {
    --nav: var(--ui-ok);
    border-color: var(--ui-ok);
}

.main-menu__nav--join > .main-menu__nav-icon {
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Outline/GlobeAlt.png");
    -unity-background-image-tint-color: var(--ui-info);
}

.main-menu__nav--local > .main-menu__nav-icon {
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Outline/Server.png");
    -unity-background-image-tint-color: var(--ui-ok);
}

.main-menu__nav--settings > .main-menu__nav-icon {
    width: 16px;
    height: 16px;
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Outline/Cog.png");
}

.main-menu .main-menu__nav--settings:hover > .main-menu__nav-icon {
    translate: 0 0;
    rotate: 60deg;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.main-menu__nav--quit > .main-menu__nav-icon {
    width: 16px;
    height: 16px;
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Outline/Logout.png");
}

.main-menu .main-menu__nav--quit:hover {
    border-color: var(--ui-danger);
}

.main-menu .main-menu__nav--quit:hover > .main-menu__nav-icon {
    -unity-background-image-tint-color: var(--ui-danger);
}

/* On the white plate the icon goes dark; the edge keeps its colour. */
.main-menu .main-menu__button--accent > .main-menu__nav-icon,
.main-menu .main-menu__nav--selected > .main-menu__nav-icon,
.main-menu .main-menu__nav--selected:hover > .main-menu__nav-icon {
    -unity-background-image-tint-color: var(--ui-text-on-light);
}

.main-menu .main-menu__nav:disabled > .main-menu__nav-icon {
    -unity-background-image-tint-color: var(--ui-menu-tab-text);
}

/* ══ A server's state: an icon in its colour ══ */
.main-menu__state-icon {
    width: 14px;
    height: 14px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.35);
}

.main-menu__state-icon--online {
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Outline/StatusOnline.png");
    -unity-background-image-tint-color: var(--ui-ok);
}

.main-menu__state-icon--update {
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Outline/CloudDownload.png");
    -unity-background-image-tint-color: var(--ui-info);
}

.main-menu__state-icon--full {
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Outline/UserGroup.png");
    -unity-background-image-tint-color: var(--ui-warn);
}

.main-menu__state-icon--offline {
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Outline/StatusOffline.png");
    -unity-background-image-tint-color: var(--ui-danger);
}

.main-menu__state-icon--older {
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Outline/Exclamation.png");
    -unity-background-image-tint-color: var(--ui-warn);
}

.main-menu__state-icon--checking {
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Outline/Refresh.png");
    -unity-background-image-tint-color: var(--ui-info);
}

/* ══ Dialogs: the operation's colour (--op), easing in, progress and step icons ══ */
.main-menu__overlay {
    --op: var(--ui-info);
    transition-property: background-color;
    transition-duration: 0.25s;
}

.main-menu__overlay--host {
    --op: var(--ui-ok);
}

.main-menu__overlay--join {
    --op: var(--ui-info);
}

.main-menu__overlay--update {
    --op: var(--ui-warn);
}

.main-menu__overlay--lost,
.main-menu__overlay--failed {
    --op: var(--ui-danger);
}

/* Shown at once without --in; MainMenuView adds it a frame later, so the plate eases in. */
.main-menu .main-menu__overlay {
    background-color: rgba(0, 0, 0, 0);
}

.main-menu .main-menu__overlay--in {
    background-color: rgba(0, 0, 0, 0.3);
}

.main-menu .main-menu__dialog {
    opacity: 0;
    scale: 0.94 0.94;
    translate: 0 12px;
    border-top-width: 3px;
    border-top-color: var(--op);
    transition-property: opacity, scale, translate, border-top-color;
    transition-duration: 0.2s, 0.32s, 0.32s, 0.3s;
    transition-timing-function: ease-out-cubic, ease-out-back, ease-out-cubic, linear;
}

.main-menu .main-menu__overlay--in .main-menu__dialog {
    opacity: 1;
    scale: 1 1;
    translate: 0 0;
}

.main-menu__op-icon {
    width: 18px;
    height: 18px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--op);
}

.main-menu__overlay--host .main-menu__op-icon {
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Outline/Server.png");
}

.main-menu__overlay--join .main-menu__op-icon {
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Outline/GlobeAlt.png");
}

.main-menu__overlay--update .main-menu__op-icon {
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Outline/CloudDownload.png");
}

.main-menu__overlay--lost .main-menu__op-icon {
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Outline/StatusOffline.png");
}

.main-menu__overlay--failed .main-menu__op-icon {
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Outline/Exclamation.png");
}

/* Progress: the done share in --op, eased; a glint runs along it while a step works. */
.main-menu__progress {
    height: 3px;
    margin: 0 16px 14px 16px;
    overflow: hidden;
    background-color: rgba(255, 255, 255, 0.08);
}

.main-menu__progress--hidden {
    display: none;
}

.main-menu__progress-fill {
    height: 100%;
    width: 0;
    overflow: hidden;
    background-color: var(--op);
    transition-property: width, background-color;
    transition-duration: 0.5s, 0.3s;
    transition-timing-function: ease-out-cubic, linear;
}

.main-menu__progress-glint {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -60px;
    width: 60px;
    background-color: rgba(255, 255, 255, 0.45);
    display: none;
}

.main-menu__progress--working .main-menu__progress-glint {
    display: flex;
}

/* Steps: an icon for the state (pending dot, the working spinner in --op, a check, a cross), the working row's edge in
   --op. The check grows in from the spinner's size, a small pop. */
.main-menu .main-menu__step {
    justify-content: flex-start;
    padding: 0 10px 0 7px;
    border-left-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    transition-property: background-color, border-color;
    transition-duration: 0.25s;
}

.main-menu .main-menu__step > .main-menu__step-label {
    flex-grow: 1;
    transition-property: color;
    transition-duration: 0.25s;
}

.main-menu .main-menu__step--active {
    border-color: var(--op);
    background-color: rgba(255, 255, 255, 0.1);
}

.main-menu .main-menu__step--failed {
    border-color: var(--ui-danger);
}

.main-menu__step-icon {
    width: 14px;
    height: 14px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    scale: 0.7 0.7;
    transition-property: scale, -unity-background-image-tint-color;
    transition-duration: 0.35s, 0.25s;
    transition-timing-function: ease-out-back, linear;
}

.main-menu__step-icon--pending {
    width: 6px;
    height: 6px;
    margin: 0 14px 0 4px;
    border-width: 1px;
    border-radius: 3px;
    border-color: rgba(255, 255, 255, 0.3);
    scale: 1 1;
}

.main-menu__step-icon--active {
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Outline/Refresh.png");
    -unity-background-image-tint-color: var(--op);
    scale: 0.85 0.85;
}

.main-menu__step-icon--done {
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Outline/Check.png");
    -unity-background-image-tint-color: var(--ui-ok);
    scale: 1 1;
}

.main-menu__step-icon--failed {
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Outline/X.png");
    -unity-background-image-tint-color: var(--ui-danger);
    scale: 1 1;
}

/* ══ Entrances (UiMotion; the looks are in Tokens/ui-controls.uss) ══
 * An element easing in takes the entrance's transitions over its own (a row's hover, a step's highlight) until
 * MainMenuView settles it: at this specificity they beat every rule above. On the arrival only, as the shared sheet:
 * the hidden look snaps. A panel takes the panel's 0.35 s. The looks (.ui-enter, its variants and .ui-enter--in) stay
 * the shared sheet's: no rule here sets opacity or translate on an element that enters, and scale only while pressed. */
.main-menu .ui-enter.ui-enter--in {
    transition-property: opacity, translate, scale;
    transition-duration: 0.24s, 0.3s, 0.3s;
    transition-timing-function: ease-out-cubic, ease-out-cubic, ease-out-back;
}

.main-menu .main-menu__panel.ui-enter.ui-enter--in {
    transition-duration: 0.24s, 0.35s, 0.35s;
}
