/* Archive palette scoped to the menu; shared gameplay chrome is unchanged. */
.main-menu {
    --menu-panel: #353538; --menu-header: #161616; --menu-inset: #2a2a2e;
    --menu-border: rgba(216,216,216,0.18); --menu-subtle: rgba(216,216,216,0.1);
    position: absolute; left: 0; right: 0; top: 0; bottom: 0; overflow: hidden;
    -unity-font-definition: url("project://database/Assets/Art/Font/TextMesh%20Pro/Fonts/LiberationSans.ttf");
    font-size: 13px; color: white; -unity-font-style: normal; background-color: black;
}
.main-menu__text { margin: 0; padding: 0; }
.main-menu Button { margin: 0; border-width: 0; color: white; -unity-font-style: normal; }
.main-menu__wallpaper { position: absolute; left: 0; right: 0; top: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop; }
.main-menu__video-wallpaper { opacity: 0; transition: opacity 0.5s; }
.main-menu__video-wallpaper--visible { opacity: 1; }
.main-menu__wallpaper-veil { background-color: black; opacity: 0; transition: opacity 0.5s; }
.main-menu__wallpaper-veil--on { opacity: 1; }
.main-menu__sidebar { position: absolute; left: 0; top: 0; bottom: 0; width: 400px; background-color: rgba(34,34,34,0.97); border-right-width: 1px; border-right-color: var(--menu-border); }

.main-menu__logo { height: 140.625px; width: 300px; margin: 32px 49px 8px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.main-menu__identity { margin: 20px 24px 0; flex-shrink: 0; }
.main-menu__eyebrow { font-size: 11px; letter-spacing: 1.32px; color: #aaaaaa; margin-bottom: 6px; }
.main-menu__input { margin: 0; padding: 0; min-width: 0; }
.main-menu__input > .unity-text-field__input { margin: 0; padding: 9px 10px; border-width: 1px; border-color: var(--menu-border); border-radius: 0; background-color: var(--menu-inset); color: white; font-size: 13px; -unity-font-style: normal; }
.main-menu__input > .unity-text-field__input:focus { border-color: #717c7f; }
.main-menu__input .unity-base-text-field__input--placeholder { color: #717c7f; }
.main-menu__navigation { margin: 20px 24px 0; flex-shrink: 0; }
.main-menu .main-menu__nav { align-items: flex-start; justify-content: center; padding: 14px 16px; margin-bottom: 4px; border-radius: 4px; background-color: var(--menu-header); -unity-text-align: middle-left; }
.main-menu .main-menu__nav:hover, .main-menu .main-menu__advanced:hover { background-color: var(--menu-inset); }
.main-menu .main-menu__nav:active, .main-menu .main-menu__button:active { background-color: #93351f; }
.main-menu__title, .main-menu__button { -unity-font-definition: url("project://database/Assets/Art/Font/Fonts/GurajadaRegular.ttf"); font-size: 20px; letter-spacing: 1.6px; -unity-font-style: normal; }
.main-menu__nav-subtitle { font-size: 12px; margin-top: 4px; letter-spacing: 0; }
.main-menu .main-menu__button--accent { background-color: #c54f30; color: #fff8ef; }
.main-menu .main-menu__button--accent:hover { background-color: #dc5528; }
.main-menu__local-row { flex-direction: row; margin-bottom: 4px; }
.main-menu .main-menu__local { flex-grow: 1; flex-basis: 0; margin: 0 2px 0 0; border-top-right-radius: 0; border-bottom-right-radius: 0; padding-top: 12px; padding-bottom: 12px; }
.main-menu .main-menu__advanced { width: 84px; background-color: var(--menu-header); color: #aaaaaa; font-size: 12px; border-radius: 0; border-top-right-radius: 4px; border-bottom-right-radius: 4px; }
.main-menu__port { flex-direction: row; align-items: center; padding: 10px 16px; margin-bottom: 4px; background-color: var(--menu-inset); border-width: 1px; border-color: var(--menu-subtle); }
.main-menu__port-input { width: 72px; margin: 0 10px; }
.main-menu__port-input > .unity-text-field__input { background-color: #222222; padding: 6px 8px; }
.main-menu__spacer { flex-grow: 1; min-height: 16px; }
.main-menu__footer { padding: 12px 24px 18px; border-top-width: 1px; border-top-color: var(--menu-subtle); flex-shrink: 0; }
.main-menu__music { flex-direction: row; align-items: center; padding: 10px 24px; border-top-width: 1px; border-top-color: var(--menu-subtle); margin-top: 16px; flex-shrink: 0; }
.main-menu .main-menu__music-toggle { width: 32px; height: 32px; padding: 0; margin: 0 10px 0 0; border-width: 0; border-radius: 2px; background-color: transparent; align-items: center; justify-content: center; flex-shrink: 0; }
.main-menu .main-menu__music-toggle--on { background-color: var(--menu-header); }
.main-menu .main-menu__music-toggle:hover, .main-menu .main-menu__music-next:hover { background-color: var(--menu-inset); color: white; }
.main-menu__music-icon { width: 16px; height: 16px; -unity-background-image-tint-color: #e0e0e0; }
.main-menu__music-text { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.main-menu__music-eyebrow { font-size: 10px; letter-spacing: 1.2px; color: #aaaaaa; }
.main-menu__music-title { margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.main-menu__music--off .main-menu__music-title { color: #aaaaaa; }
.main-menu__music--off .main-menu__music-icon, .main-menu__music--off .main-menu__music-volume { opacity: 0.4; }
.main-menu .main-menu__music-next { height: 32px; padding: 0 8px; margin: 0 0 0 10px; border-width: 0; border-radius: 2px; background-color: transparent; color: #aaaaaa; font-size: 12px; flex-shrink: 0; }
/* Unity's slider has an 18px+ field box with the tracker near its top; pin every part to a 16px box centred in the row. */
.main-menu #music-volume { width: 96px; height: 16px; min-height: 16px; margin: 0 0 0 10px; padding: 0; flex-shrink: 0; align-self: center; }
.main-menu #music-volume > .unity-base-slider__input { height: 16px; min-height: 16px; margin: 0; padding: 0; }
.main-menu #music-volume .unity-base-slider__drag-container { height: 16px; margin: 0; padding: 0; }
.main-menu #music-volume .unity-base-slider__tracker { top: 5px; height: 6px; margin: 0; background-color: var(--menu-inset); border-width: 1px; border-color: var(--menu-border); border-radius: 3px; }
.main-menu #music-volume .unity-base-slider__dragger { position: absolute; top: 1px; width: 14px; height: 14px; margin: 0; background-color: #aaaaaa; border-width: 0; border-radius: 7px; }
.main-menu #music-volume .unity-base-slider__dragger-border { display: none; }
.main-menu__footer > .main-menu__row { margin-top: 4px; }
.main-menu .main-menu__link { padding: 0; background-color: transparent; color: #d8d8d8; font-size: 12px; border-radius: 0; border-bottom-width: 1px; border-bottom-color: #aaaaaa; margin-left: 3px; }
.main-menu .main-menu__link:hover { color: white; border-bottom-color: white; }
.main-menu__row { flex-direction: row; align-items: center; }
.main-menu__spread { justify-content: space-between; }
.main-menu__end { justify-content: flex-end; }
.main-menu__secondary { color: #aaaaaa; }
.main-menu__mono { -unity-font-definition: url("project://database/Assets/Art/Font/Fonts/SpessmanFont.ttf"); font-size: 12px; }
.main-menu__tiny { font-size: 11px; }
.main-menu__wrap { white-space: normal; }
.main-menu__bold { -unity-font-style: bold; }
.main-menu__large { font-size: 15px; }
.main-menu__beside { margin-left: 12px; }
.main-menu__update { margin: 8px 24px 0; padding: 12px; border-width: 1px; border-color: #3d6089; border-radius: 2px; background-color: var(--menu-inset); flex-shrink: 0; }
.main-menu__banner-copy { font-size: 12px; margin: 8px 0; }
.main-menu__dot { width: 8px; height: 8px; border-radius: 8px; background-color: #88b36a; margin-right: 8px; flex-shrink: 0; }
.main-menu__dot--blue { background-color: #5f86b3; }
.main-menu .main-menu__button { height: 40px; padding: 0 16px; background-color: var(--menu-header); border-radius: 4px; flex-shrink: 0; -unity-text-align: middle-center; }
.main-menu .main-menu__button:hover { background-color: var(--menu-inset); }
.main-menu .main-menu__button--blue { background-color: #3d6089; }
.main-menu .main-menu__button--blue:hover { background-color: #5f86b3; }
.main-menu .main-menu__button--danger { background-color: #b13d3d; }
.main-menu .main-menu__button:disabled, .main-menu .main-menu__nav:disabled { background-color: var(--menu-inset); color: #5a5d60; }
.main-menu .main-menu__nav:disabled Label { color: #5a5d60; }
.main-menu__panel { position: absolute; left: 424px; top: 24px; bottom: 24px; right: 24px; max-width: 960px; background-color: var(--menu-panel); border-width: 1px; border-color: var(--menu-border); border-radius: 4px; }
/* Rounded overflow clipping renders solid white at runtime on Linux; round the header instead. */
.main-menu__header { flex-direction: row; align-items: center; padding: 10px 12px 10px 16px; background-color: var(--menu-header); flex-shrink: 0; min-height: 60px; border-top-left-radius: 3px; border-top-right-radius: 3px; }
.main-menu__header > Button { margin-left: 12px; }
.main-menu__server-scroll { flex-grow: 1; min-height: 0; }
.main-menu__server-content { padding: 16px; }
.main-menu__section { margin-bottom: 20px; }
.main-menu__direct-row { flex-direction: row; align-items: center; margin-top: 6px; }
.main-menu__address { flex-grow: 1; flex-basis: 0; margin-right: 8px; }
.main-menu__first { padding: 16px; border-width: 1px; border-color: var(--menu-border); background-color: var(--menu-inset); border-radius: 2px; }
.main-menu__first > Label { margin-bottom: 10px; }
.main-menu__first > .main-menu__link { align-self: flex-start; margin-top: 10px; }
.main-menu__server { background-color: var(--menu-inset); border-width: 1px; border-color: var(--menu-subtle); border-radius: 2px; margin-top: 6px; }
.main-menu__server-row { flex-direction: row; align-items: center; padding: 8px 12px; min-height: 58px; }
.main-menu__server-heading { flex-direction: row; padding: 0 13px; color: #aaaaaa; font-size: 11px; margin-top: 6px; }
.main-menu__server-identity { flex-grow: 1; flex-basis: 0; min-width: 0; margin-right: 12px; }
.main-menu__server-name { -unity-font-style: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.main-menu__server-address { margin-top: 3px; font-size: 11px; color: #aaaaaa; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.main-menu__status { width: 200px; margin-right: 12px; font-size: 12px; }
.main-menu__players { width: 52px; margin-right: 12px; -unity-text-align: middle-right; }
.main-menu__ping { width: 60px; margin-right: 12px; -unity-text-align: middle-right; color: #aaaaaa; }
.main-menu__actions { width: 148px; flex-direction: row; justify-content: flex-end; align-items: center; }
.main-menu .main-menu__details-button { font-size: 12px; color: #aaaaaa; background-color: transparent; padding: 6px; margin-right: 8px; }
.main-menu .main-menu__details-button:hover { color: white; background-color: var(--menu-panel); }
.main-menu__refusal { flex-direction: row; justify-content: space-between; padding: 7px 12px 7px 34px; border-top-width: 1px; border-top-color: var(--menu-subtle); background-color: rgba(185,72,72,0.14); font-size: 12px; color: #d17a7a; }
.main-menu__details { padding: 12px 12px 12px 34px; border-top-width: 1px; border-top-color: var(--menu-subtle); }
.main-menu__detail-row { flex-direction: row; align-items: center; margin-bottom: 10px; }
.main-menu__detail-key { width: 122px; color: #aaaaaa; font-size: 12px; }
.main-menu__detail-value { width: 360px; flex-shrink: 1; }
.main-menu__empty { padding: 14px 12px; border-width: 1px; border-color: var(--menu-border); border-radius: 2px; margin-top: 6px; }
.main-menu__empty > Label { margin-bottom: 4px; }
.main-menu__settings { flex-grow: 1; align-items: center; justify-content: center; padding: 32px; }
.main-menu__settings-copy { max-width: 420px; padding: 20px; }
.main-menu__overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(22,22,22,0.55); align-items: center; justify-content: center; }
.main-menu__dialog { width: 440px; background-color: var(--menu-panel); border-width: 1px; border-color: var(--menu-border); border-radius: 4px; }
.main-menu__dialog > .main-menu__header { min-height: 44px; padding: 12px 16px; }
.main-menu__dialog-body { padding: 16px; }
.main-menu__dialog-body > .main-menu__mono { margin-top: 3px; }
.main-menu__steps { margin: 14px 0; }
.main-menu__step { flex-direction: row; justify-content: space-between; padding: 6px 10px; background-color: var(--menu-inset); border-radius: 2px; margin-bottom: 2px; }
.main-menu__step-reason { padding: 7px 10px; margin-bottom: 2px; border-radius: 2px; background-color: rgba(185,72,72,0.14); font-size: 12px; color: #d17a7a; }
.main-menu__token-row { flex-direction: row; align-items: center; margin-bottom: 14px; }
.main-menu__token-input { flex-grow: 1; flex-shrink: 1; }
.main-menu .main-menu__dialog-action { margin-left: 8px; }
.main-menu__hint { margin-top: 6px; }
.main-menu .main-menu__hidden { display: none; }
/* The 720p reference keeps the sidebar fixed and lets long list columns contract. */
.main-menu--compact .main-menu__status { width: 116px; }
.main-menu--compact .main-menu__players { width: 44px; }
.main-menu--compact .main-menu__ping { width: 48px; }
.main-menu--compact .main-menu__actions { width: 132px; }

/* Fixed text boxes reproduce the reference's line-height: 1 titling without the font's tall metrics. */
.main-menu__nav > .main-menu__title { height: 20px; flex-shrink: 0; -unity-text-align: middle-left; }
.main-menu__nav > .main-menu__nav-subtitle { height: 14px; flex-shrink: 0; }
.main-menu .main-menu__nav.main-menu__title { height: 48px; }
.main-menu__header > .main-menu__title { height: 20px; -unity-text-align: middle-left; }
.main-menu .main-menu__details-button, .main-menu .main-menu__link { height: auto; -unity-font-definition: url("project://database/Assets/Art/Font/TextMesh%20Pro/Fonts/LiberationSans.ttf"); letter-spacing: 0; }
.main-menu__banner-copy { margin: 8px 0; }
.main-menu__update > .main-menu__row > .main-menu__beside { flex-shrink: 1; }

.main-menu .main-menu__button.main-menu__button--accent { background-color: #c54f30; }
.main-menu .main-menu__button.main-menu__button--accent:hover { background-color: #dc5528; }

.main-menu .main-menu__button { font-size: 15px; padding-left: 20px; padding-right: 20px; }
.main-menu .main-menu__details-button, .main-menu .main-menu__link { padding-left: 6px; padding-right: 6px; font-size: 12px; }
.main-menu .main-menu__link { padding: 0; }

.main-menu .main-menu__button:disabled { background-color: var(--menu-inset); color: #5a5d60; opacity: 1; }
.main-menu .main-menu__advanced { flex-direction: row; align-items: center; justify-content: center; }
.main-menu__caret { width: 0; height: 0; margin-left: 4px; border-left-width: 3px; border-right-width: 3px; border-top-width: 4px; border-left-color: transparent; border-right-color: transparent; border-top-color: #aaaaaa; }
.main-menu__caret--up { rotate: 180deg; }

.main-menu .main-menu__nav:disabled { opacity: 1; }
.main-menu .main-menu__nav.main-menu__nav--selected { background-color: var(--menu-panel); }
.main-menu__empty { border-color: transparent; }

.main-menu .main-menu__music-volume-fill { position: absolute; left: 0; top: 0; bottom: 0; background-color: #aaaaaa; border-radius: 3px; }
