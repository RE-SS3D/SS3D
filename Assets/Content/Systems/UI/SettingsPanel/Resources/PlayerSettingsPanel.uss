@import url("../../Tokens/ui-tokens.uss");
@import url("../../Tokens/ui-controls.uss");

/*
 * Player Settings screen (main menu, lobby, Escape menu), drawn with the UI bible's parts (the "main menu" tab's
 * Settings state; components.css "Settings in the panel"): no plate of its own, so it sits on its host's plate.
 *   header        a Disket title, the context, an Esc chip and Back
 *   tabs          the map editor's sub-tabs: the open one gets a 2 px white line under its label
 *   rows          light tints; labels in Disket, notes in Kode; a changed setting has a dot in the info colour
 *   segmented     dark plates in the row, the chosen one white
 *   keys          the map editor's key chips at row size
 * Buttons keep the runtime theme's .unity-button class, so every Button class here sets its own background, border and
 * colour for :hover and :active too, or the theme's light grey shows through.
 */

.settings-theme {
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/KodeMonoSDF.asset");
    -unity-text-generator: standard; /* the baked fonts are static font assets */
    font-size: 12px;
    color: var(--ui-text);
}

.settings-theme Label {
    margin: 0;
    padding: 0;
    color: var(--ui-text);
}

.settings-theme .unity-disabled {
    opacity: 1;
}

.settings-panel {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.settings-theme .settings-panel__mono {
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/KodeMonoSDF.asset");
    font-size: 12px;
}

/* ── Header: a title on the plate, no band ── */
.settings-panel__header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 56px;
    padding: 0 12px 0 20px;
}

.settings-theme .settings-panel__title {
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 20px;
}

.settings-theme .settings-panel__context {
    margin-left: 12px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.5);
}

.settings-panel__spacer {
    flex-grow: 1;
}

/* Esc: the map editor's key chip. */
.settings-theme .settings-panel__esc {
    height: 16px;
    margin-right: 8px;
    padding: 0 4px;
    border-radius: 2.4px;
    background-color: rgba(0, 0, 0, 0.45);
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 9px;
    color: rgba(255, 255, 255, 0.7);
    -unity-text-align: middle-center;
}

/* ── Buttons: the main menu's, a light tint with a Disket label; the primary is the white plate ── */
.settings-theme .settings-panel__button {
    height: 32px;
    margin: 0;
    padding: 0 14px;
    flex-shrink: 0;
    border-width: var(--ui-hairline);
    border-radius: 0;
    border-color: rgba(0, 0, 0, 0);
    background-color: var(--ui-editor-button);
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 12px;
    color: var(--ui-text);
    white-space: nowrap;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color;
    transition-duration: 0.09s;
}

.settings-theme .settings-panel__button:hover {
    background-color: var(--ui-editor-button-hover);
}

.settings-theme .settings-panel__button:active,
.settings-theme .settings-panel__button:hover:active {
    background-color: var(--ui-editor-button-pressed);
}

.settings-theme .settings-panel__button--accent {
    background-color: var(--ui-menu-selected);
    color: var(--ui-text-on-light);
}

.settings-theme .settings-panel__button--accent:hover {
    background-color: rgb(255, 255, 255);
}

.settings-theme .settings-panel__button--accent:active,
.settings-theme .settings-panel__button--accent:hover:active {
    background-color: rgb(207, 207, 204);
}

/* Reset, armed: a second click resets, so the warn colour. */
.settings-theme .settings-panel__button--amber,
.settings-theme .settings-panel__button--amber:hover {
    border-color: var(--ui-warn);
    background-color: rgba(238, 186, 78, 0.16);
    color: var(--ui-warn);
}

/* ── Tabs: the map editor's sub-tabs ── */
.settings-panel__tabs {
    flex-direction: row;
    flex-shrink: 0;
    padding: 0 14px;
}

.settings-theme .settings-panel__tab,
.settings-theme .settings-panel__tab:hover,
.settings-theme .settings-panel__tab:active,
.settings-theme .settings-panel__tab:hover:active {
    background-color: rgba(0, 0, 0, 0);
}

.settings-theme .settings-panel__tab {
    height: 30px;
    margin: 0;
    padding: 1px 10px 0 10px;
    justify-content: center;
    border-width: 0 0 2px 0;
    border-radius: 0;
    border-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 13px;
    color: rgba(255, 255, 255, 0.45);
    -unity-text-align: middle-center;
}

.settings-theme .settings-panel__tab:hover {
    color: rgba(255, 255, 255, 0.8);
}

.settings-theme .settings-panel__tab--active,
.settings-theme .settings-panel__tab--active:hover {
    border-color: var(--ui-line-active);
    color: var(--ui-text);
}

/* ── Scroll ── */
.settings-panel__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.settings-panel .unity-scroller--vertical {
    width: 6px;
    min-width: 6px;
    max-width: 6px;
    margin-left: 2px;
}

.settings-panel .unity-scroller__low-button,
.settings-panel .unity-scroller__high-button {
    display: none;
}

.settings-panel .unity-scroller__slider {
    width: 6px;
    min-width: 6px;
    margin: 0;
}

.settings-panel .unity-scroller__slider .unity-base-slider__tracker {
    width: 6px;
    left: 0;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0);
}

.settings-panel .unity-scroller__slider .unity-base-slider__dragger {
    width: 6px;
    left: 0;
    margin-left: 0;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.22);
}

.settings-panel .unity-scroller__slider .unity-base-slider__dragger:hover {
    background-color: rgba(255, 255, 255, 0.4);
}

.settings-panel .unity-scroller__slider .unity-base-slider__dragger-border {
    display: none;
}

.settings-panel__content {
    padding: 16px 20px 20px 20px;
}

.settings-panel__intro-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
}

.settings-theme .settings-panel__intro {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 320px;
    margin: 4px 16px 4px 0;
    font-size: 11.5px;
    color: rgba(255, 255, 255, 0.55);
    white-space: normal;
}

/* Mute All: a warning, so the warn colour on its edge. */
.settings-panel__banner {
    flex-direction: row;
    align-items: center;
    margin-bottom: 18px;
    padding: 10px 12px;
    border-width: var(--ui-hairline);
    border-color: var(--ui-warn);
    background-color: rgba(238, 186, 78, 0.08);
}

.settings-theme .settings-panel__banner-text {
    flex-shrink: 1;
    font-size: 11.5px;
    color: var(--ui-warn);
    white-space: normal;
}

/* ── Groups and rows ── */
.settings-panel__group {
    margin-bottom: 18px;
}

.settings-theme .settings-panel__group-title {
    margin-bottom: 6px;
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 10px;
    color: rgba(255, 255, 255, 0.5);
}

.settings-panel__group-heading {
    flex-direction: row;
    justify-content: space-between;
}

.settings-theme .settings-panel__group-sub {
    font-size: 10.5px;
    color: rgba(255, 255, 255, 0.5);
}

.settings-panel__row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    margin-bottom: 2px;
    padding: 6px 8px 6px 12px;
    background-color: var(--ui-editor-button);
}

.settings-panel__row-copy {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 220px;
    min-width: 0;
    margin: 4px 16px 4px 0;
}

.settings-panel__row-line {
    flex-direction: row;
    align-items: center;
}

.settings-theme .settings-panel__row-label {
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 12px;
    color: rgba(255, 255, 255, 0.85);
}

/* Changed from the default: a small dot after the label, in the news colour. */
.settings-panel__changed {
    width: 6px;
    height: 6px;
    margin-left: 8px;
    border-radius: 3px;
    background-color: var(--ui-info);
}

.settings-panel__note {
    flex-direction: row;
    align-items: center;
    margin-top: 5px;
}

.settings-theme .settings-panel__note-text {
    flex-shrink: 1;
    font-size: 10.5px;
    color: rgba(255, 255, 255, 0.5);
    white-space: normal;
}

.settings-theme .settings-panel__note--warning .settings-panel__note-text {
    color: var(--ui-warn);
}

.settings-theme .settings-panel__note--steel .settings-panel__note-text {
    color: rgba(255, 255, 255, 0.8);
}

.settings-panel__note > .settings-panel__lock {
    margin-right: 6px;
}

.settings-panel__note--steel .settings-panel__lock-body {
    background-color: rgba(255, 255, 255, 0.8);
}

.settings-panel__note--steel .settings-panel__lock-shackle {
    border-color: rgba(255, 255, 255, 0.8);
}

.settings-panel__control {
    flex-grow: 0;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
}

/* A padlock from two boxes: the font has no glyph for one. */
.settings-panel__lock {
    width: 10px;
    height: 11px;
    flex-shrink: 0;
}

.settings-panel__lock-shackle {
    position: absolute;
    left: 2px;
    top: 0;
    width: 6px;
    height: 6px;
    border-width: 1px 1px 0 1px;
    border-color: rgba(255, 255, 255, 0.5);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}

.settings-panel__lock-body {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 10px;
    height: 6px;
    border-radius: 1px;
    background-color: rgba(255, 255, 255, 0.5);
}

/* ── Segmented: dark plates in the row, the chosen one white ── */
.settings-panel__segments {
    flex-wrap: wrap;
    justify-content: flex-end;
}

.settings-theme .settings-panel__segment,
.settings-theme .settings-panel__segment:hover,
.settings-theme .settings-panel__segment:active,
.settings-theme .settings-panel__segment:hover:active,
.settings-theme .settings-panel__segment:disabled {
    background-color: rgba(0, 0, 0, 0.5);
}

.settings-theme .settings-panel__segment {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-width: 52px;
    height: 28px;
    margin: 1px 0 1px 2px;
    padding: 0 10px;
    border-width: 0;
    border-radius: 0;
}

.settings-theme .settings-panel__segment-text {
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 11px;
    color: rgba(255, 255, 255, 0.45);
    white-space: nowrap;
}

.settings-theme .settings-panel__segment:hover .settings-panel__segment-text {
    color: rgba(255, 255, 255, 0.85);
}

.settings-theme .settings-panel__segment > .settings-panel__lock {
    margin-right: 6px;
}

.settings-theme .settings-panel__segment--on,
.settings-theme .settings-panel__segment--on:hover,
.settings-theme .settings-panel__segment--on:active,
.settings-theme .settings-panel__segment--on:hover:active {
    background-color: var(--ui-menu-selected);
}

.settings-theme .settings-panel__segment--on .settings-panel__segment-text,
.settings-theme .settings-panel__segment--on:hover .settings-panel__segment-text {
    color: var(--ui-text-on-light);
}

/* Locked by another setting: the effective choice shows with a padlock, and nothing can change. */
.settings-theme .settings-panel__segment--locked-on,
.settings-theme .settings-panel__segment--locked-on:disabled {
    border-width: 1px;
    border-color: var(--ui-editor-cell-edge);
    background-color: var(--ui-editor-button-hover);
}

.settings-theme .settings-panel__segment--locked-on .settings-panel__segment-text {
    color: var(--ui-text);
}

.settings-panel__segment--locked-on .settings-panel__lock-body {
    background-color: var(--ui-text);
}

.settings-panel__segment--locked-on .settings-panel__lock-shackle {
    border-color: var(--ui-text);
}

.settings-theme .settings-panel__segment--locked-off .settings-panel__segment-text {
    color: rgba(255, 255, 255, 0.2);
}

/* ── Sliders: the menu slider, a dark track with a light line for the level ── */
.settings-panel__slider {
    width: 220px;
    height: 16px;
    min-height: 16px;
    margin: 0;
    padding: 0;
    flex-shrink: 1;
}

.settings-panel__slider > .unity-base-slider__input {
    height: 16px;
    min-height: 16px;
    margin: 0;
    padding: 0;
}

.settings-panel__slider .unity-base-slider__drag-container {
    height: 16px;
    margin: 0;
    padding: 0;
}

.settings-panel__slider .unity-base-slider__tracker {
    top: 4px;
    height: 8px;
    margin: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0.45);
}

.settings-panel__slider .unity-base-slider__dragger {
    position: absolute;
    top: 1px;
    width: 27px;
    height: 14px;
    margin: 0;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.24);
    border-radius: 3px;
    background-color: rgba(42, 38, 40, 0.96);
}

.settings-panel__slider:hover .unity-base-slider__dragger {
    border-color: rgba(255, 255, 255, 0.7);
}

.settings-panel__slider .unity-base-slider__dragger-border {
    display: none;
}

.settings-panel__slider-fill {
    position: absolute;
    left: 0;
    top: 3px;
    height: 2px;
    background-color: rgba(255, 255, 255, 0.36);
}

.settings-theme .settings-panel__slider-value {
    width: 48px;
    margin-left: 10px;
    font-size: 12px;
    -unity-text-align: middle-right;
}

.settings-theme .settings-panel__slider-value--dim {
    color: rgba(255, 255, 255, 0.4);
}

/* ── Select: a UiSelect (Tokens/ui-controls.uss draws it); here only its width ── */
.settings-panel__select {
    width: 220px;
}

/* ── Controls ── */
.settings-panel__legend {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 18px;
    padding: 8px 12px;
}

.settings-panel__legend-item {
    flex-direction: row;
    align-items: center;
    margin: 4px 20px 4px 0;
}

.settings-theme .settings-panel__legend-text {
    margin-left: 8px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.55);
}

.settings-panel__legend-item > .settings-panel__lock {
    margin-right: -2px;
}

.settings-panel__bind-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-right: -16px;
}

.settings-panel__bind-group {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 380px;
    min-width: 300px;
    margin: 0 16px 18px 0;
}

/* An action and its key: a row; the key is the map editor's chip at row size. */
.settings-theme .settings-panel__bind {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 40px;
    margin: 0 0 2px 0;
    padding: 5px 6px 5px 12px;
    border-width: 1px;
    border-radius: 0;
    border-color: rgba(0, 0, 0, 0);
    background-color: var(--ui-editor-button);
}

.settings-theme .settings-panel__bind:hover,
.settings-theme .settings-panel__bind:active,
.settings-theme .settings-panel__bind:hover:active {
    background-color: var(--ui-editor-button-hover);
}

/* Moved by a swap: a flash in the news colour. */
.settings-theme .settings-panel__bind--flash {
    border-color: var(--ui-info);
    background-color: rgba(120, 196, 236, 0.12);
}

.settings-theme .settings-panel__bind--listening,
.settings-theme .settings-panel__bind--listening:hover {
    border-color: var(--ui-line-active);
    background-color: var(--ui-editor-button-hover);
}

.settings-panel__bind-copy {
    flex-shrink: 1;
    min-width: 0;
    margin-right: 12px;
}

.settings-theme .settings-panel__bind-label {
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 12px;
    color: rgba(255, 255, 255, 0.85);
}

.settings-theme .settings-panel__bind-hint {
    margin-top: 3px;
    font-size: 10.5px;
    color: rgba(255, 255, 255, 0.5);
}

.settings-theme .settings-panel__bind-hint--listening {
    color: var(--ui-text);
}

.settings-panel__bind-keys {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.settings-theme .settings-panel__prefix {
    margin-right: 6px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.5);
}

.settings-theme .settings-panel__keycap {
    min-width: 64px;
    height: 26px;
    padding: 0 10px;
    border-width: var(--ui-hairline);
    border-radius: 3.9px; /* 15 % */
    border-color: var(--ui-editor-cell-edge);
    background-color: rgba(0, 0, 0, 0.45);
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 11px;
    color: var(--ui-text);
    -unity-text-align: middle-center;
    transition-property: opacity, border-color;
    transition-duration: 0.3s;
}

.settings-theme .settings-panel__bind:hover .settings-panel__keycap {
    border-color: var(--ui-editor-cell-edge-hover);
}

.settings-theme .settings-panel__keycap--small {
    min-width: 26px;
    height: 20px;
    padding: 0 6px;
    font-size: 10px;
}

.settings-theme .settings-panel__keycap--listening {
    border-color: var(--ui-line-active);
    color: var(--ui-text);
}

.settings-panel__keycap--dim {
    opacity: 0.55;
}

.settings-panel__fixed {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 32px;
    padding: 2px 6px 2px 12px;
}

.settings-panel__fixed-label {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
}

.settings-theme .settings-panel__fixed-text {
    margin-left: 8px;
    color: rgba(255, 255, 255, 0.5);
}

.settings-theme .settings-panel__fixed-key {
    padding: 0 10px;
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 10px;
    color: rgba(255, 255, 255, 0.5);
}

/* ── Notices: a strip along the bottom ── */
.settings-panel__notice {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 10px 20px;
    border-top-width: var(--ui-hairline);
    border-color: rgba(255, 255, 255, 0.08);
    background-color: rgba(0, 0, 0, 0.3);
}

.settings-panel__notice-dot {
    width: 8px;
    height: 8px;
    margin-right: 10px;
    flex-shrink: 0;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.3);
}

.settings-theme .settings-panel__notice-text {
    flex-shrink: 1;
    font-size: 11.5px;
    white-space: normal;
}

.settings-panel__notice--swap {
    border-color: var(--ui-info);
    background-color: rgba(120, 196, 236, 0.08);
}

.settings-panel__notice--swap .settings-panel__notice-dot {
    background-color: var(--ui-info);
}

.settings-panel__notice--refused {
    border-color: var(--ui-danger);
    background-color: rgba(235, 98, 82, 0.12);
}

.settings-panel__notice--refused .settings-panel__notice-dot {
    background-color: var(--ui-danger);
}

/* ── "Keep these settings?": a floating plate over a dim ── */
.settings-prompt {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.4);
}

.settings-prompt__card {
    width: 440px;
    max-width: 90%;
    border-width: var(--ui-hairline);
    border-radius: var(--ui-panel-radius);
    border-color: var(--ui-panel-edge);
    background-color: var(--ui-float);
}

.settings-panel__header.settings-prompt__header {
    height: 48px;
    padding: 0 16px;
}

.settings-theme .settings-prompt__header > .settings-panel__title {
    font-size: 16px;
}

.settings-prompt__body {
    padding: 0 16px 16px 16px;
}

.settings-theme .settings-prompt__what {
    margin-bottom: 6px;
    font-size: 14px;
    white-space: normal;
}

.settings-prompt__line {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 12px;
}

.settings-theme .settings-prompt__secondary {
    font-size: 11.5px;
    color: rgba(255, 255, 255, 0.55);
}

.settings-theme .settings-prompt__value {
    font-size: 11.5px;
}

.settings-prompt__track {
    height: 4px;
    margin-bottom: 12px;
    background-color: rgba(255, 255, 255, 0.08);
}

.settings-prompt__bar {
    height: 4px;
    background-color: var(--ui-warn);
    transition-property: width;
    transition-duration: 0.3s;
    transition-timing-function: linear;
}

.settings-prompt__actions {
    flex-direction: row;
    justify-content: flex-end;
}

.settings-theme .settings-prompt__actions > .settings-panel__button {
    margin-left: 6px;
}
