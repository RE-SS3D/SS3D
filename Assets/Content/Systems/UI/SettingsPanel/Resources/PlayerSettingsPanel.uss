@import url("../../Tokens/ui-tokens.uss");
@import url("../../Tokens/ui-controls.uss");

/*
 * Player Settings screen (main menu, lobby, Escape menu), drawn with the UI bible's parts (the "main menu" tab's
 * Settings state; components.css "Settings in the panel"): no plate of its own, so it sits on its host's plate.
 *   header        the cog in the open tab's colour, a Disket title, the context, an Esc chip and Back
 *   tabs          the map editor's sub-tabs with an icon each: the open one gets a 2 px white line under its label.
 *                 Each tab has a colour (--tab): its icon on hover and while open, and through the open tab's content
 *                 (the header's cog, the groups' ticks, the sliders' level)
 *   rows          light tints, lighter on hover; labels in Disket, notes in Kode; a changed setting has a dot in the
 *                 info colour. Groups are titled in Disket after a tick in the tab's colour
 *   segmented     dark plates in the row, the chosen one white
 *   keys          the map editor's key chips at row size
 *   state areas   a soft fill (--ui-*-soft) and a 3 px left edge: Mute All's banner, Reset armed, the notices
 *   motion        0.12 s on every hover and press, a press sinks a plate a little; a tab's content and a notice ease
 *                 in, the Keep prompt pops in (UiMotion, from PlayerSettingsPanel)
 * Buttons keep the runtime theme's .unity-button class, so every Button class here sets its own background, border and
 * colour for :hover and :active too, or the theme's light grey shows through.
 */

.settings-theme {
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/KodeMonoSDF.asset");
    -unity-text-generator: standard; /* the baked fonts are static font assets */
    font-size: 12px;
    color: var(--ui-text);
}

.settings-theme Label {
    margin: 0;
    padding: 0;
    color: var(--ui-text);
}

.settings-theme .unity-disabled {
    opacity: 1;
}

.settings-panel {
    --tab: var(--ui-text);
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

/* The open tab's colour reaches its content (PlayerSettingsPanel adds settings-panel--<tab>). A category colour, not a
   state: the state colours stay for what they mean (the changed dot, warnings, notices). */
.settings-panel--display {
    --tab: var(--ui-cat-scripts);
}

.settings-panel--audio {
    --tab: var(--ui-cat-items);
}

.settings-panel--controls {
    --tab: var(--ui-cat-lower);
}

.settings-theme .settings-panel__mono {
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/KodeMonoSDF.asset");
    font-size: 12px;
}

/* ── Header: a title on the plate, no band ── */
.settings-panel__header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 56px;
    padding: 0 12px 0 20px;
}

.settings-theme .settings-panel__title {
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 20px;
}

/* The screen's cog, in the open tab's colour: it changes as the tabs do. */
.settings-panel__title-icon {
    width: 20px;
    height: 20px;
    margin-right: 12px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Outline/Cog.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--tab);
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.25s;
}

.settings-theme .settings-panel__context {
    margin-left: 12px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.5);
}

.settings-panel__spacer {
    flex-grow: 1;
}

/* Esc: the map editor's key chip. */
.settings-theme .settings-panel__esc {
    height: 16px;
    margin-right: 8px;
    padding: 0 4px;
    border-radius: 2.4px;
    background-color: rgba(0, 0, 0, 0.45);
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 9px;
    color: rgba(255, 255, 255, 0.7);
    -unity-text-align: middle-center;
}

/* ── Buttons: the main menu's. A Disket label; the primary is the white plate, a secondary a light tint with a faint
   edge. A press sinks it a little ── */
.settings-theme .settings-panel__button {
    height: 32px;
    margin: 0;
    padding: 0 14px;
    flex-shrink: 0;
    border-width: var(--ui-hairline);
    border-radius: 0;
    border-color: rgba(255, 255, 255, 0.08);
    background-color: var(--ui-editor-button);
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 12px;
    color: var(--ui-text);
    white-space: nowrap;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color, color, scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out-cubic;
}

.settings-theme .settings-panel__button:hover {
    background-color: var(--ui-editor-button-hover);
    border-color: rgba(255, 255, 255, 0.24);
}

.settings-theme .settings-panel__button:active,
.settings-theme .settings-panel__button:hover:active {
    background-color: var(--ui-editor-button-pressed);
    scale: 0.97 0.97;
}

.settings-theme .settings-panel__button--accent {
    border-color: rgba(0, 0, 0, 0);
    background-color: var(--ui-menu-selected);
    color: var(--ui-text-on-light);
}

/* The white plate can't get whiter: its hover is a faint ok wash (keep, confirm). */
.settings-theme .settings-panel__button--accent:hover {
    border-color: rgba(0, 0, 0, 0);
    background-color: rgb(236, 251, 241);
}

.settings-theme .settings-panel__button--accent:active,
.settings-theme .settings-panel__button--accent:hover:active {
    background-color: rgb(207, 207, 204);
}

/* Reset, armed: a second click resets, so a warn area: its edge, a soft fill, the label in warn. */
.settings-theme .settings-panel__button--amber,
.settings-theme .settings-panel__button--amber:hover,
.settings-theme .settings-panel__button--amber:hover:active {
    border-color: var(--ui-warn);
    background-color: var(--ui-warn-soft);
    color: var(--ui-warn);
}

/* ── Tabs: the map editor's sub-tabs, an icon before each label ── */
.settings-panel__tabs {
    flex-direction: row;
    flex-shrink: 0;
    padding: 0 14px;
}

.settings-theme .settings-panel__tab,
.settings-theme .settings-panel__tab:hover,
.settings-theme .settings-panel__tab:active,
.settings-theme .settings-panel__tab:hover:active,
.settings-theme .settings-panel__tab:focus {
    background-color: rgba(0, 0, 0, 0);
    color: rgba(0, 0, 0, 0);
}

/* The Button keeps its own text, which pilots find a tab by (LobbyUiPilot), but draws it clear: a Label child draws
   the label beside the icon, and children size the button. */
.settings-theme .settings-panel__tab {
    --tab: var(--ui-text);
    flex-direction: row;
    align-items: center;
    height: 30px;
    margin: 0;
    padding: 1px 12px 0 10px;
    justify-content: center;
    border-width: 0 0 2px 0;
    border-radius: 0;
    border-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 13px;
    color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
    transition-property: border-color, scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out-cubic;
}

.settings-theme .settings-panel__tab:active,
.settings-theme .settings-panel__tab:hover:active {
    scale: 0.96 0.96;
}

.settings-theme .settings-panel__tab--display {
    --tab: var(--ui-cat-scripts);
}

.settings-theme .settings-panel__tab--audio {
    --tab: var(--ui-cat-items);
}

.settings-theme .settings-panel__tab--controls {
    --tab: var(--ui-cat-lower);
}

.settings-theme .settings-panel__tab--active,
.settings-theme .settings-panel__tab--active:hover {
    border-color: var(--ui-line-active);
}

.settings-panel__tab-icon {
    width: 14px;
    height: 14px;
    margin-right: 7px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.4);
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.12s;
}

.settings-panel__tab--display .settings-panel__tab-icon {
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Outline/DesktopComputer.png");
}

.settings-panel__tab--audio .settings-panel__tab-icon {
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Outline/VolumeUp.png");
}

.settings-panel__tab--controls .settings-panel__tab-icon {
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Outline/CursorClick.png");
}

/* Hover shows the tab's colour; the open tab keeps it. */
.settings-theme .settings-panel__tab:hover .settings-panel__tab-icon,
.settings-theme .settings-panel__tab--active .settings-panel__tab-icon {
    -unity-background-image-tint-color: var(--tab);
}

.settings-theme .settings-panel__tab-text {
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 13px;
    color: rgba(255, 255, 255, 0.45);
    transition-property: color;
    transition-duration: 0.12s;
}

.settings-theme .settings-panel__tab:hover .settings-panel__tab-text {
    color: rgba(255, 255, 255, 0.8);
}

.settings-theme .settings-panel__tab.settings-panel__tab--active .settings-panel__tab-text {
    color: var(--ui-text);
}

/* ── Scroll ── */
.settings-panel__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.settings-panel .unity-scroller--vertical {
    width: 6px;
    min-width: 6px;
    max-width: 6px;
    margin-left: 2px;
}

.settings-panel .unity-scroller__low-button,
.settings-panel .unity-scroller__high-button {
    display: none;
}

.settings-panel .unity-scroller__slider {
    width: 6px;
    min-width: 6px;
    margin: 0;
}

.settings-panel .unity-scroller__slider .unity-base-slider__tracker {
    width: 6px;
    left: 0;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0);
}

.settings-panel .unity-scroller__slider .unity-base-slider__dragger {
    width: 6px;
    left: 0;
    margin-left: 0;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.22);
}

.settings-panel .unity-scroller__slider .unity-base-slider__dragger:hover {
    background-color: rgba(255, 255, 255, 0.4);
}

.settings-panel .unity-scroller__slider .unity-base-slider__dragger-border {
    display: none;
}

.settings-panel__content {
    padding: 16px 20px 20px 20px;
}

.settings-panel__intro-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
}

.settings-theme .settings-panel__intro {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 320px;
    margin: 4px 16px 4px 0;
    font-size: 11.5px;
    color: rgba(255, 255, 255, 0.55);
    white-space: normal;
}

/* Mute All: a warning, so a warn area: its edge, a soft fill, the muted speaker. */
.settings-panel__banner {
    flex-direction: row;
    align-items: center;
    margin-bottom: 18px;
    padding: 10px 12px 10px 9px;
    border-left-width: 3px;
    border-color: var(--ui-warn);
    background-color: var(--ui-warn-soft);
}

.settings-panel__banner-icon {
    width: 16px;
    height: 16px;
    margin-right: 10px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/Art/Icons/Heroicons/Outline/VolumeOff.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--ui-warn);
}

.settings-theme .settings-panel__banner-text {
    flex-shrink: 1;
    font-size: 11.5px;
    color: var(--ui-warn);
    white-space: normal;
}

/* ── Groups and rows ── */
.settings-panel__group {
    margin-bottom: 18px;
}

/* A group's title: Disket after a tick in the open tab's colour. */
.settings-theme .settings-panel__group-title {
    margin-bottom: 6px;
    padding-left: 7px;
    border-left-width: 3px;
    border-color: var(--tab);
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 10px;
    color: rgba(255, 255, 255, 0.62);
}

.settings-panel__group-heading {
    flex-direction: row;
    justify-content: space-between;
}

.settings-theme .settings-panel__group-sub {
    font-size: 10.5px;
    color: rgba(255, 255, 255, 0.5);
}

.settings-panel__row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    margin-bottom: 2px;
    padding: 6px 8px 6px 12px;
    background-color: var(--ui-editor-button);
    transition-property: background-color;
    transition-duration: 0.12s;
}

.settings-panel__row:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

.settings-panel__row-copy {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 220px;
    min-width: 0;
    margin: 4px 16px 4px 0;
}

.settings-panel__row-line {
    flex-direction: row;
    align-items: center;
}

.settings-theme .settings-panel__row-label {
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 12px;
    color: rgba(255, 255, 255, 0.85);
}

/* Changed from the default: a small dot after the label, in the news colour. */
.settings-panel__changed {
    width: 6px;
    height: 6px;
    margin-left: 8px;
    border-radius: 3px;
    background-color: var(--ui-info);
}

.settings-panel__note {
    flex-direction: row;
    align-items: center;
    margin-top: 5px;
}

.settings-theme .settings-panel__note-text {
    flex-shrink: 1;
    font-size: 10.5px;
    color: rgba(255, 255, 255, 0.5);
    white-space: normal;
}

.settings-theme .settings-panel__note--warning .settings-panel__note-text {
    color: var(--ui-warn);
}

.settings-theme .settings-panel__note--steel .settings-panel__note-text {
    color: rgba(255, 255, 255, 0.8);
}

.settings-panel__note > .settings-panel__lock {
    margin-right: 6px;
}

.settings-panel__note--steel .settings-panel__lock-body {
    background-color: rgba(255, 255, 255, 0.8);
}

.settings-panel__note--steel .settings-panel__lock-shackle {
    border-color: rgba(255, 255, 255, 0.8);
}

.settings-panel__control {
    flex-grow: 0;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
}

/* A padlock from two boxes: the font has no glyph for one. */
.settings-panel__lock {
    width: 10px;
    height: 11px;
    flex-shrink: 0;
}

.settings-panel__lock-shackle {
    position: absolute;
    left: 2px;
    top: 0;
    width: 6px;
    height: 6px;
    border-width: 1px 1px 0 1px;
    border-color: rgba(255, 255, 255, 0.5);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}

.settings-panel__lock-body {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 10px;
    height: 6px;
    border-radius: 1px;
    background-color: rgba(255, 255, 255, 0.5);
}

/* ── Segmented: dark plates in the row, lifting on hover; the chosen one white (it fades in as it is picked) ── */
.settings-panel__segments {
    flex-wrap: wrap;
    justify-content: flex-end;
}

.settings-theme .settings-panel__segment,
.settings-theme .settings-panel__segment:disabled,
.settings-theme .settings-panel__segment:disabled:hover {
    background-color: rgba(0, 0, 0, 0.5);
}

.settings-theme .settings-panel__segment:hover {
    background-color: rgba(0, 0, 0, 0.3);
}

.settings-theme .settings-panel__segment:active,
.settings-theme .settings-panel__segment:hover:active {
    background-color: rgba(0, 0, 0, 0.3);
    scale: 0.95 0.95;
}

.settings-theme .settings-panel__segment {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-width: 52px;
    height: 28px;
    margin: 1px 0 1px 2px;
    padding: 0 10px;
    border-width: 0;
    border-radius: 0;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out-cubic;
}

.settings-theme .settings-panel__segment-text {
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 11px;
    color: rgba(255, 255, 255, 0.45);
    white-space: nowrap;
    transition-property: color;
    transition-duration: 0.12s;
}

.settings-theme .settings-panel__segment:hover .settings-panel__segment-text {
    color: rgba(255, 255, 255, 0.85);
}

.settings-theme .settings-panel__segment > .settings-panel__lock {
    margin-right: 6px;
}

.settings-theme .settings-panel__segment--on,
.settings-theme .settings-panel__segment--on:hover,
.settings-theme .settings-panel__segment--on:active,
.settings-theme .settings-panel__segment--on:hover:active {
    background-color: var(--ui-menu-selected);
}

.settings-theme .settings-panel__segment--on .settings-panel__segment-text,
.settings-theme .settings-panel__segment--on:hover .settings-panel__segment-text {
    color: var(--ui-text-on-light);
}

/* Locked by another setting: the effective choice shows with a padlock, and nothing can change. */
.settings-theme .settings-panel__segment--locked-on,
.settings-theme .settings-panel__segment--locked-on:disabled,
.settings-theme .settings-panel__segment--locked-on:disabled:hover {
    border-width: 1px;
    border-color: var(--ui-editor-cell-edge);
    background-color: var(--ui-editor-button-hover);
}

.settings-theme .settings-panel__segment--locked-on .settings-panel__segment-text {
    color: var(--ui-text);
}

.settings-panel__segment--locked-on .settings-panel__lock-body {
    background-color: var(--ui-text);
}

.settings-panel__segment--locked-on .settings-panel__lock-shackle {
    border-color: var(--ui-text);
}

.settings-theme .settings-panel__segment--locked-off .settings-panel__segment-text {
    color: rgba(255, 255, 255, 0.2);
}

/* ── Sliders: the menu slider, a dark track with a light line for the level ── */
.settings-panel__slider {
    width: 220px;
    height: 16px;
    min-height: 16px;
    margin: 0;
    padding: 0;
    flex-shrink: 1;
}

.settings-panel__slider > .unity-base-slider__input {
    height: 16px;
    min-height: 16px;
    margin: 0;
    padding: 0;
}

.settings-panel__slider .unity-base-slider__drag-container {
    height: 16px;
    margin: 0;
    padding: 0;
}

.settings-panel__slider .unity-base-slider__tracker {
    top: 4px;
    height: 8px;
    margin: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0.45);
}

.settings-panel__slider .unity-base-slider__dragger {
    position: absolute;
    top: 1px;
    width: 27px;
    height: 14px;
    margin: 0;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.24);
    border-radius: 3px;
    background-color: rgba(42, 38, 40, 0.96);
    transition-property: border-color;
    transition-duration: 0.12s;
}

.settings-panel__slider:hover .unity-base-slider__dragger {
    border-color: rgba(255, 255, 255, 0.7);
}

.settings-panel__slider .unity-base-slider__dragger-border {
    display: none;
}

/* The level, in the open tab's colour. */
.settings-panel__slider-fill {
    position: absolute;
    left: 0;
    top: 3px;
    height: 2px;
    background-color: var(--tab);
}

.settings-theme .settings-panel__slider-value {
    width: 48px;
    margin-left: 10px;
    font-size: 12px;
    -unity-text-align: middle-right;
}

.settings-theme .settings-panel__slider-value--dim {
    color: rgba(255, 255, 255, 0.4);
}

/* ── Select: a UiSelect (Tokens/ui-controls.uss draws it); here only its width ── */
.settings-panel__select {
    width: 220px;
}

/* ── Controls ── */
.settings-panel__legend {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 18px;
    padding: 8px 12px;
}

.settings-panel__legend-item {
    flex-direction: row;
    align-items: center;
    margin: 4px 20px 4px 0;
}

.settings-theme .settings-panel__legend-text {
    margin-left: 8px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.55);
}

.settings-panel__legend-item > .settings-panel__lock {
    margin-right: -2px;
}

.settings-panel__bind-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-right: -16px;
}

.settings-panel__bind-group {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 380px;
    min-width: 300px;
    margin: 0 16px 18px 0;
}

/* An action and its key: a row; the key is the map editor's chip at row size. */
.settings-theme .settings-panel__bind {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 40px;
    margin: 0 0 2px 0;
    padding: 5px 6px 5px 12px;
    border-width: 1px;
    border-radius: 0;
    border-color: rgba(0, 0, 0, 0);
    background-color: var(--ui-editor-button);
    transition-property: background-color, border-color, scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out-cubic;
}

.settings-theme .settings-panel__bind:hover {
    border-color: rgba(255, 255, 255, 0.14);
    background-color: var(--ui-editor-button-hover);
}

.settings-theme .settings-panel__bind:active,
.settings-theme .settings-panel__bind:hover:active {
    background-color: var(--ui-editor-button-hover);
    scale: 0.985 0.985;
}

/* Moved by a swap: a flash in the news colour (stronger than its soft fill: it has to catch the eye), fading out as
   the class comes off. */
.settings-theme .settings-panel__bind--flash {
    border-color: var(--ui-info);
    background-color: rgba(86, 178, 255, 0.14);
}

.settings-theme .settings-panel__bind--listening,
.settings-theme .settings-panel__bind--listening:hover {
    border-color: var(--ui-line-active);
    background-color: var(--ui-editor-button-hover);
}

.settings-panel__bind-copy {
    flex-shrink: 1;
    min-width: 0;
    margin-right: 12px;
}

.settings-theme .settings-panel__bind-label {
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 12px;
    color: rgba(255, 255, 255, 0.85);
}

.settings-theme .settings-panel__bind-hint {
    margin-top: 3px;
    font-size: 10.5px;
    color: rgba(255, 255, 255, 0.5);
}

.settings-theme .settings-panel__bind-hint--listening {
    color: var(--ui-text);
}

.settings-panel__bind-keys {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.settings-theme .settings-panel__prefix {
    margin-right: 6px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.5);
}

.settings-theme .settings-panel__keycap {
    min-width: 64px;
    height: 26px;
    padding: 0 10px;
    border-width: var(--ui-hairline);
    border-radius: 3.9px; /* 15 % */
    border-color: var(--ui-editor-cell-edge);
    background-color: rgba(0, 0, 0, 0.45);
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 11px;
    color: var(--ui-text);
    -unity-text-align: middle-center;
    transition-property: opacity, border-color;
    transition-duration: 0.3s;
}

.settings-theme .settings-panel__bind:hover .settings-panel__keycap {
    border-color: var(--ui-editor-cell-edge-hover);
}

.settings-theme .settings-panel__keycap--small {
    min-width: 26px;
    height: 20px;
    padding: 0 6px;
    font-size: 10px;
}

.settings-theme .settings-panel__keycap--listening {
    border-color: var(--ui-line-active);
    color: var(--ui-text);
}

.settings-panel__keycap--dim {
    opacity: 0.55;
}

.settings-panel__fixed {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 32px;
    padding: 2px 6px 2px 12px;
}

.settings-panel__fixed-label {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
}

.settings-theme .settings-panel__fixed-text {
    margin-left: 8px;
    color: rgba(255, 255, 255, 0.5);
}

.settings-theme .settings-panel__fixed-key {
    padding: 0 10px;
    -unity-font-definition: url("project://database/Assets/Content/Systems/UI/Font/Fonts/DisketMonoBoldSDF.asset");
    font-size: 10px;
    color: rgba(255, 255, 255, 0.5);
}

/* ── Notices: a strip along the bottom that rises in (UiMotion); a swap is an info area, a refusal a danger one ── */
.settings-panel__notice {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 10px 20px 10px 17px;
    border-left-width: 3px;
    border-color: rgba(255, 255, 255, 0.3);
    background-color: rgba(0, 0, 0, 0.3);
}

.settings-panel__notice-dot {
    width: 8px;
    height: 8px;
    margin-right: 10px;
    flex-shrink: 0;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.3);
}

.settings-theme .settings-panel__notice-text {
    flex-shrink: 1;
    font-size: 11.5px;
    white-space: normal;
}

.settings-panel__notice--swap {
    border-color: var(--ui-info);
    background-color: var(--ui-info-soft);
}

.settings-panel__notice--swap .settings-panel__notice-dot {
    background-color: var(--ui-info);
}

.settings-panel__notice--refused {
    border-color: var(--ui-danger);
    background-color: var(--ui-danger-soft);
}

.settings-panel__notice--refused .settings-panel__notice-dot {
    background-color: var(--ui-danger);
}

/* ── "Keep these settings?": a floating plate over a dim ── */
.settings-prompt {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.4);
}

.settings-prompt__card {
    width: 440px;
    max-width: 90%;
    border-width: var(--ui-hairline);
    border-radius: var(--ui-panel-radius);
    border-color: var(--ui-panel-edge);
    background-color: var(--ui-float);
}

.settings-panel__header.settings-prompt__header {
    height: 48px;
    padding: 0 16px;
}

.settings-theme .settings-prompt__header > .settings-panel__title {
    font-size: 16px;
}

.settings-prompt__body {
    padding: 0 16px 16px 16px;
}

.settings-theme .settings-prompt__what {
    margin-bottom: 6px;
    font-size: 14px;
    white-space: normal;
}

.settings-prompt__line {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 12px;
}

.settings-theme .settings-prompt__secondary {
    font-size: 11.5px;
    color: rgba(255, 255, 255, 0.55);
}

.settings-theme .settings-prompt__value {
    font-size: 11.5px;
}

.settings-prompt__track {
    height: 4px;
    margin-bottom: 12px;
    background-color: rgba(255, 255, 255, 0.08);
}

.settings-prompt__bar {
    height: 4px;
    background-color: var(--ui-warn);
    transition-property: width;
    transition-duration: 0.3s;
    transition-timing-function: linear;
}

.settings-prompt__actions {
    flex-direction: row;
    justify-content: flex-end;
}

.settings-theme .settings-prompt__actions > .settings-panel__button {
    margin-left: 6px;
}
