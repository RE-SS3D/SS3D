# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/*
!/Library/FishNet.Runtime.Editor.PrefabObjects.Generation.Settings.json
/[Tt]emp/
/[Oo]bj/

/[Bb]uilds/*
!Builds/Game/
!Builds/Update_SS3D.ps1
!Builds/update_ss3d.py
!/[Bb]uilds/*.bat
!/[Bb]uilds/*.sh
!/[Bb]uilds/README.txt
!/[Bb]uilds/TESTERS.md

Builds/Game/*
!Builds/Game/Data/
!/[Bb]uilds/Game/Config/
!/[Bb]uilds/Game/BUILD_THE_GAME_HERE.txt

# Runtime server persistence (generated on boot / save; not source data)
/[Bb]uilds/Game/[Dd]ata/[Ss]erver[Mm]eta/
# Map editor sharing output (Save & Export, imported zips)
/[Bb]uilds/Game/[Dd]ata/[Ee]xports/
/[Bb]uilds/Game/[Dd]ata/[Ss]tation[Tt]emplates/[Ii]mported[Zz]ips/


/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Unity license files should never be committed
*.ulf
/Documents/UnityLicense.ulf

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/*
/[Aa]ssets/Plugins.meta
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/
.vscode/
.vsconfig

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[aA]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Unity3D generated Addressables
/[Uu]nity[Ee]ngine.[Cc]ontent.[Aa]ddressables.[Bb]uild[Pp]ath/

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Files generated by SS3D tools that should not be commited.
/[Aa]ssets/Temp/*

\.idea/

# Autogenerated Blender files
*.blend1

# Autogenerated Maya files
/.[Mm]aya[Ss]watches/
/.[Vv]ray[Tt]humbs/

#Some annoying generated files by the project
Assets/Content/Data/DefaultPrefabObjects.asset
Assets/Content/Addressables/Windows/addressables_content_state.bin
Assets/Content/Addressables/Windows/addressables_content_state.bin.meta
Assets/Content/Addressables/link.xml
Assets/Content/Addressables/link.xml.meta

# Art index generator cache (regenerated by Tools/generate_art_index.py)
Tools/.ss3d-art-tree-cache.json

# Multiplayer test harness per-run scratch (staged build copies, logs) - see Testing/multiplayer/
Testing/multiplayer/.runs/

# Local / CI Unity runner output (editmode, build logs)
/artifacts/

# Local Python bytecode and Addressables build/profile caches (not authored groups).
__pycache__/
*.py[cod]
/Assets/Content/Addressables/Linux.meta
/Assets/Content/Addressables/Linux/addressables_content_state.bin
/Assets/Content/Addressables/Linux/addressables_content_state.bin.meta
/Assets/AddressableAssetsData.meta
/Assets/AddressableAssetsData/ProfileDataSourceSettings.asset
/Assets/AddressableAssetsData/ProfileDataSourceSettings.asset.meta

# Generated from git by BuildInfoGenerator (editor load / player build)
/Assets/Content/Systems/UI/Lobby/Resources/BuildInfo.json
/Assets/Content/Systems/UI/Lobby/Resources/BuildInfo.json.meta

# Written by Unity's Performance Testing package on every editor test run.
/Assets/Resources/PerformanceTestRunInfo.json
/Assets/Resources/PerformanceTestRunInfo.json.meta
/Assets/Resources/PerformanceTestRunSettings.json
/Assets/Resources/PerformanceTestRunSettings.json.meta

# Multiplayer Play Mode per-machine player tags
ProjectSettings/VirtualProjectsConfig.json
